<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- CA1707: underscore naming is the standard xUnit test-method convention.
         CA1716: the test tree mirrors src/ folder for folder, so a namespace like CLI.Shared is
         forced by the production layout it shadows. The rule guards cross-language consumers of a
         public API; nothing consumes this assembly, and production's own CLI.Shared is unflagged
         only because its types are internal while xUnit requires public test classes. -->
    <NoWarn>$(NoWarn);CA1707;CA1716;S3267;S3878</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpGLTF.Toolkit" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BethesdaMultitool\BethesdaMultitool.csproj" />
    <!-- EsmAnalyzer is referenced so its text adapters (e.g. the OpenMW esmtool dump parser) can be
         unit-tested directly; it exposes internals to this assembly via InternalsVisibleTo. -->
    <ProjectReference Include="..\..\tools\EsmAnalyzer\EsmAnalyzer.csproj" />
  </ItemGroup>

  <!-- The profiler is a WinUI executable and cannot be referenced from this platform-neutral test
       target. Its option/selector contract is platform-neutral, so compile those exact sources into
       the test assembly instead of leaving the unattended capture CLI untested. -->
  <ItemGroup>
    <Compile Include="..\..\src\BethesdaRendererProfiler\RendererProfilerOptions.cs"
             Link="Profiler\RendererProfilerOptions.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\CaptureSelectionGuard.cs"
             Link="Profiler\CaptureSelectionGuard.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\CaptureReadinessGuard.cs"
             Link="Profiler\CaptureReadinessGuard.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\CaptureImageFingerprint.cs"
             Link="Profiler\CaptureImageFingerprint.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\CaptureWorkingSetTrimDiagnostic.cs"
             Link="Profiler\CaptureWorkingSetTrimDiagnostic.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\ProfileSceneSettlementTracker.cs"
             Link="Profiler\ProfileSceneSettlementTracker.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\RendererProfilerScenarioCatalog.cs"
             Link="Profiler\RendererProfilerScenarioCatalog.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\RendererProfilerScenarioContracts.cs"
             Link="Profiler\RendererProfilerScenarioContracts.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\RendererProfilerScenarioAssertions.cs"
             Link="Profiler\RendererProfilerScenarioAssertions.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\RendererProfilerScenarioRunner.cs"
             Link="Profiler\RendererProfilerScenarioRunner.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\RendererProfilerScenarioTraceSink.cs"
             Link="Profiler\RendererProfilerScenarioTraceSink.cs" />
  </ItemGroup>

</Project>
