<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- CA1707: underscore naming is the standard xUnit test-method convention.
         CS0618: several suites intentionally exercise the deprecated-but-still-shipping PluginBuilder
         (the conversion orchestrator slated for replacement by PluginConversionPipeline). -->
    <NoWarn>$(NoWarn);CA1707;S3267;S3878;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpGLTF.Toolkit" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BethesdaMultitool\BethesdaMultitool.csproj" />
  </ItemGroup>

</Project>
