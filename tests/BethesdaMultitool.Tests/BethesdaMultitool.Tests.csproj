<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- CA1707: underscore naming is the standard xUnit test-method convention.
         CS0618: several suites intentionally exercise the deprecated-but-still-shipping PluginBuilder
         (the conversion orchestrator slated for replacement by PluginConversionPipeline). -->
    <NoWarn>$(NoWarn);CA1707;S3267;S3878;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpGLTF.Toolkit" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BethesdaMultitool\BethesdaMultitool.csproj" />
    <!-- EsmAnalyzer is referenced so its text adapters (e.g. the OpenMW esmtool dump parser) can be
         unit-tested directly; it exposes internals to this assembly via InternalsVisibleTo. -->
    <ProjectReference Include="..\..\tools\EsmAnalyzer\EsmAnalyzer.csproj" />
  </ItemGroup>

  <!-- The profiler is a WinUI executable and cannot be referenced from this platform-neutral test
       target. Its option/selector contract is platform-neutral, so compile those exact sources into
       the test assembly instead of leaving the unattended capture CLI untested. -->
  <ItemGroup>
    <Compile Include="..\..\src\BethesdaRendererProfiler\RendererProfilerOptions.cs"
             Link="Profiler\RendererProfilerOptions.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\CaptureSelectionGuard.cs"
             Link="Profiler\CaptureSelectionGuard.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\CaptureReadinessGuard.cs"
             Link="Profiler\CaptureReadinessGuard.cs" />
    <Compile Include="..\..\src\BethesdaRendererProfiler\CaptureImageFingerprint.cs"
             Link="Profiler\CaptureImageFingerprint.cs" />
  </ItemGroup>

</Project>
