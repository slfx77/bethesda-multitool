using System.Numerics;
using BethesdaMultitool.Core.Formats.Nif.Rendering;
using BethesdaMultitool.Core.Formats.Nif.Rendering.Export;
using BethesdaMultitool.Tests.Helpers;
using Xunit;

namespace BethesdaMultitool.Tests.Core.Formats.Nif.Rendering.Export;

public sealed class BgsmGlbEmissionSourceContractTests
{
    [Fact]
    public void ExportClonesPreserveResolvedBgsmEmissionState()
    {
        var worldExportSource = SourceContract.ReadSource(
            "src", "BethesdaMultitool", "Core", "Formats", "Nif", "Rendering", "Export",
            "NifExportSceneBuilder.cs");
        var npcExportSource = SourceContract.ReadSource(
            "src", "BethesdaMultitool", "Core", "Formats", "Nif", "Rendering", "Npc", "Assembly",
            "NpcExportSceneBuilder.cs");
        var cloneSource = SourceContract.ReadSource(
            "src", "BethesdaMultitool", "Core", "Formats", "Nif", "Rendering",
            "RenderableSubmeshCloner.cs");
        var cliNpcCloneSource = SourceContract.ReadSource(
            "src", "BethesdaMultitool", "CLI", "Rendering", "Npc", "NpcMeshHelpers.cs");

        Assert.Contains("RenderableSubmeshCloner.DeepClone(part.Submesh)", worldExportSource,
            StringComparison.Ordinal);
        Assert.Contains("RenderableSubmeshCloner.CloneGeometryWithRenderState(geometry, materialSource)",
            worldExportSource,
            StringComparison.Ordinal);
        Assert.Contains("RenderableSubmeshCloner.DeepClone(submesh)", npcExportSource,
            StringComparison.Ordinal);
        Assert.Contains("BgsmGlowMapTexturePath = renderState.BgsmGlowMapTexturePath", cloneSource,
            StringComparison.Ordinal);
        Assert.Contains("BgsmEmissionColor = renderState.BgsmEmissionColor", cloneSource,
            StringComparison.Ordinal);
        Assert.Contains("BgsmGlowMapTexturePath = sub.BgsmGlowMapTexturePath", cliNpcCloneSource,
            StringComparison.Ordinal);
        Assert.Contains("BgsmEmissionColor = sub.BgsmEmissionColor", cliNpcCloneSource,
            StringComparison.Ordinal);
    }

    [Fact]
    public void RegularBgsmEmissionUsesItsOwnPathAndFactorInGltf()
    {
        var source = SourceContract.ReadSource(
            "src", "BethesdaMultitool", "Core", "Formats", "Nif", "Rendering", "Export",
            "GlbWriter.cs");

        SourceContract.AssertOrder(
            source,
            "var hasActiveBgsmEmission = TryEncodeGltfEmission(",
            "var bgsmGlowTexture",
            "var hasExternalRegularBgsm",
            "var inlineEmissiveTexture = !hasExternalRegularBgsm",
            "var emissiveTexturePath",
            "var emissiveFactor",
            "var emissiveStrength",
            "new MaterialCacheKey(",
            "emissiveTexturePath,",
            "hasActiveBgsmEmission,",
            "emissiveFactor,",
            "emissiveStrength,",
            "material.WithEmissive(emissiveImage, emissiveFactor, emissiveStrength);",
            "material.WithEmissive(emissiveFactor, emissiveStrength);");
    }

    [Fact]
    public void HdrEmissionIsSplitBetweenBoundedFactorAndStrength()
    {
        var effective = new Vector3(0.988560736f, 1.25f, 2.88482833f);

        Assert.True(GlbWriter.TryEncodeGltfEmission(effective, out var factor, out var strength));

        Assert.InRange(factor.X, 0f, 1f);
        Assert.InRange(factor.Y, 0f, 1f);
        Assert.InRange(factor.Z, 0f, 1f);
        Assert.Equal(effective.Z, strength);
        var reconstructed = factor * strength;
        Assert.Equal(effective.X, reconstructed.X, 6);
        Assert.Equal(effective.Y, reconstructed.Y, 6);
        Assert.Equal(effective.Z, reconstructed.Z, 6);
    }

    [Fact]
    public void LdrEmissionKeepsUnitStrength()
    {
        var effective = new Vector3(0.25f, 0.5f, 0.75f);

        Assert.True(GlbWriter.TryEncodeGltfEmission(effective, out var factor, out var strength));

        Assert.Equal(effective, factor);
        Assert.Equal(1f, strength);
    }

    [Theory]
    [MemberData(nameof(InvalidEmissionValues))]
    public void InvalidOrInactiveEmissionFailsClosed(Vector3 effective)
    {
        Assert.False(GlbWriter.TryEncodeGltfEmission(effective, out var factor, out var strength));
        Assert.Equal(Vector3.Zero, factor);
        Assert.Equal(1f, strength);
    }

    public static TheoryData<Vector3> InvalidEmissionValues => new()
    {
        Vector3.Zero,
        new Vector3(-0.01f, 0.5f, 0.5f),
        new Vector3(float.NaN, 0.5f, 0.5f),
        new Vector3(0.5f, float.PositiveInfinity, 0.5f)
    };

    [Fact]
    public void ExternalBgsmMaterialIsAuthoritativeEvenWithoutActiveEmission()
    {
        var explicitMaterial = new RenderableSubmesh
        {
            ShaderMetadata = new NifShaderTextureMetadata
            {
                MaterialPath = "materials\\architecture\\wall.bgsm"
            }
        };
        var legacyDiffuseFallback = new RenderableSubmesh
        {
            DiffuseTexturePath = "materials\\architecture\\wall.bgsm"
        };

        Assert.True(GlbWriter.HasExternalRegularBgsmMaterial(explicitMaterial));
        Assert.True(GlbWriter.HasExternalRegularBgsmMaterial(legacyDiffuseFallback));
        Assert.False(GlbWriter.HasExternalRegularBgsmMaterial(new RenderableSubmesh()));
    }
}
