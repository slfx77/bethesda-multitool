<Project>
  <Import Project="shared/Multitool.Shared/build/Multitool.Dependencies.props" Condition="!$(MSBuildProjectFullPath.Contains('DDXConv'))" />
  <Import Project="shared/Multitool.Shared/build/Multitool.Analyzers.Versions.props" Condition="!$(MSBuildProjectFullPath.Contains('DDXConv'))" />
  <PropertyGroup>
    <!-- Centralize package versions for the main repo. Skip the DDXConv submodule
         (src/DDXConv/**) so its standalone csproj versions remain authoritative
         and the submodule stays diff-free. -->
    <ManagePackageVersionsCentrally Condition="!$(MSBuildProjectFullPath.Contains('DDXConv'))">true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- CLI / console -->
    <PackageVersion Include="Spectre.Console" Version="0.55.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.8" />

    <!-- Image / model / GPU -->
    <!-- 14.14.0 fixes CVE-2026-49219 / GHSA-xcjm-wqff-m669 (policy-bypass file read via symlink). -->
    <PackageVersion Include="Magick.NET-Q16-AnyCPU" Version="14.14.0" />
    <!-- Pure-managed BCn decoder (BC1-7 + BC6H) for DX10-header DDS (FO4/FO76). ImageSharp-free base
         package; 2.2.0 matches the transitive version the DDXConv submodule's BCnEncoder.Net.ImageSharp
         pulls in (its 1.1.2 wrapper depends on base 2.2.0). -->
    <!-- BCnEncoder.Net uses the common version imported from Shared. -->
    <PackageVersion Include="Vortice.Direct3D12" Version="3.8.2" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
    <PackageVersion Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageVersion Include="Vortice.WinUI" Version="3.8.3" />

    <!-- WinUI 3 / Windows App SDK -->
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />

    <!-- Audio / speech -->
    <PackageVersion Include="NAudio" Version="2.3.0" />
    <PackageVersion Include="Whisper.net" Version="1.9.0" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.0" />

    <!-- Testing -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
