<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Deliberately standalone: no ProjectReference to BethesdaMultitool. The generator only
         mirrors trees and shells to 7z, so keeping it out of the main graph means it builds in
         seconds and never drags in the net10.0-windows GUI TFM. -->
    <RootNamespace>SampleGenerator</RootNamespace>
  </PropertyGroup>

</Project>
