bool DamageCodeMatches(bool installed) noexcept {
    const auto plan=DamagePlan(false);
    std::array<std::uint8_t,2048> actual{};
    for(const auto& constant:DamageConstants) {
        if(!ActorEffectMapped(constant.address,8,false) || !DamageRead(constant.address,actual.data(),8))return false;
        for(unsigned byte=0;byte<8;++byte) {
            const auto nibble=[](char c){return c<='9'?c-'0':c-'a'+10;};
            if(actual[byte]!=static_cast<std::uint8_t>((nibble(constant.hex[byte*2])<<4)|nibble(constant.hex[byte*2+1])))return false;
        }
    }
    for(const auto& proof:DamageProofs) {
        const size_t length=strlen(proof.hex)/2;
        if(length>actual.size() || !ActorEffectMapped(proof.address,length,true) || !DamageRead(proof.address,actual.data(),length))return false;
        if(installed && g_damageProofNormalizer && !g_damageProofNormalizer(proof.address,actual.data(),length))return false;
        for(size_t byte=0;byte<length;++byte) {
            const auto nibble=[](char c){return c<='9'?c-'0':c-'a'+10;};
            const auto expected=static_cast<std::uint8_t>((nibble(proof.hex[byte*2])<<4)|nibble(proof.hex[byte*2+1]));
            std::uint8_t accepted=expected;
            if(installed)for(const auto& span:plan)if(proof.address+byte>=span.address && proof.address+byte<span.address+span.length)
                accepted=span.after[proof.address+byte-span.address];
            // A separately integrated critical caller hook must normalize its
            // exact owned009B5619 CALL here; no wildcard hook acceptance.
            if(actual[byte]!=accepted)return false;
        }
    }
    return true;
}
