<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- CA1707: underscore naming is the standard xUnit test-method convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EsmSchemaGen\EsmSchemaGen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not referenced: this project sits outside BethesdaMultitool.slnx and has no
         dependency on the main test project, but it locates retail masters the same way. Sharing
         the one locator keeps a second copy of the drive-probing logic from drifting. -->
    <Compile Include="..\..\tests\BethesdaMultitool.Tests\Helpers\RealAssetPaths.cs"
             Link="Helpers\RealAssetPaths.cs" />
  </ItemGroup>

</Project>
