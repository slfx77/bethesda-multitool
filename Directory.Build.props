<Project>
  <PropertyGroup>
    <MultitoolEnableAnalyzerPackages Condition="$(MSBuildProjectName.StartsWith('BethesdaMultitool'))">true</MultitoolEnableAnalyzerPackages>
  </PropertyGroup>
  <Import Project="shared/Multitool.Shared/build/Multitool.Analyzers.props" />
  <PropertyGroup>
    <RestorePackagesWithLockFile Condition="!$(MSBuildProjectFullPath.Contains('DDXConv'))">true</RestorePackagesWithLockFile>
    <!-- Enable .NET analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Nullable reference types -->
    <Nullable>enable</Nullable>

    <!-- Implicit usings for modern C# -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Use latest C# language version -->
    <LangVersion>latest</LangVersion>

    <!-- Generate documentation comments (Release only to speed up Debug builds) -->
    <GenerateDocumentationFile Condition="'$(Configuration)' == 'Release'">true</GenerateDocumentationFile>

    <!-- Suppress XML documentation warnings for now (can enable later) -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1712;CS0436</NoWarn>

    <!-- Enable deterministic builds -->
    <Deterministic>true</Deterministic>

    <!-- Disable NuGet audit to avoid offline restore failures -->
    <NuGetAuditMode>None</NuGetAuditMode>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

</Project>
