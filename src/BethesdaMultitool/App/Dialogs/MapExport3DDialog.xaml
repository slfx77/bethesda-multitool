<?xml version="1.0" encoding="utf-8"?>

<ContentDialog
  x:Class="BethesdaMultitool.MapExport3DDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Export 3D worldspace"
  PrimaryButtonText="Export..."
  CloseButtonText="Cancel"
  DefaultButton="Primary"
  AutomationProperties.Name="Export 3D worldspace"
  AutomationProperties.HeadingLevel="Level1">

  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
    <StackPanel Spacing="14" MinWidth="400">

      <!-- Projection + direction on one line. -->
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Projection" Style="{StaticResource BodyStrongTextBlockStyle}"
                     AutomationProperties.HeadingLevel="Level2" />
          <ComboBox x:Name="ProjectionComboBox" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Projection"
                    SelectionChanged="ProjectionComboBox_SelectionChanged" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Direction (top of image)" Style="{StaticResource BodyStrongTextBlockStyle}"
                     AutomationProperties.HeadingLevel="Level2" />
          <ComboBox x:Name="DirectionComboBox" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Direction"
                    SelectionChanged="DirectionComboBox_SelectionChanged" />
        </StackPanel>
      </Grid>

      <StackPanel Spacing="4">
        <TextBlock Text="Scale" Style="{StaticResource BodyStrongTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Text="1× renders a player-height object (≈128 units) 64 px tall."
                   FontSize="11" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="0.25x" Click="ScalePreset_Click" Tag="0.25"
                  AutomationProperties.Name="Quarter scale" ToolTipService.ToolTip="Player ≈ 16 px tall" />
          <Button Content="0.5x" Click="ScalePreset_Click" Tag="0.5"
                  AutomationProperties.Name="Half scale" ToolTipService.ToolTip="Player ≈ 32 px tall" />
          <Button Content="1x" Click="ScalePreset_Click" Tag="1"
                  AutomationProperties.Name="Native scale" ToolTipService.ToolTip="Player ≈ 64 px tall" />
          <Button Content="2x" Click="ScalePreset_Click" Tag="2"
                  AutomationProperties.Name="Double scale" ToolTipService.ToolTip="Player ≈ 128 px tall" />
          <Button Content="4x" Click="ScalePreset_Click" Tag="4"
                  AutomationProperties.Name="Quadruple scale" ToolTipService.ToolTip="Player ≈ 256 px tall" />
        </StackPanel>
      </StackPanel>

      <CheckBox x:Name="TiledCheckBox" Content="Tiled high-res (multiple PNGs + manifest)" IsChecked="True"
                AutomationProperties.Name="Tiled high-res"
                Checked="TiledCheckBox_Changed" Unchecked="TiledCheckBox_Changed" />

      <TextBlock x:Name="OutputSizeText" FontSize="11" TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

      <StackPanel Spacing="4">
        <TextBlock Text="Include" Style="{StaticResource BodyStrongTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level2" />
        <CheckBox x:Name="TerrainCheckBox" Content="Terrain" />
        <CheckBox x:Name="MeshesCheckBox" Content="Meshes (placed objects)" />
        <CheckBox x:Name="WaterCheckBox" Content="Water" />
        <CheckBox x:Name="TreesCheckBox" Content="Trees" />
        <CheckBox x:Name="ActivatorsCheckBox" Content="Activators" />
        <CheckBox x:Name="MarkersCheckBox" Content="Editor markers" />
        <CheckBox x:Name="DisabledCheckBox" Content="Initially-disabled objects" />
        <CheckBox x:Name="NavMeshCheckBox" Content="Nav mesh" />
        <CheckBox x:Name="CollisionCheckBox" Content="Havok collision" />
        <CheckBox x:Name="GridCheckBox" Content="Cell grid" />
        <CheckBox x:Name="LightingCheckBox" Content="Lighting" />
        <CheckBox x:Name="FogCheckBox" Content="Fog" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</ContentDialog>
