<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="BethesdaMultitool.DdxConverterTab"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:live="using:BethesdaMultitool.Localization"
  xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
  xmlns:local="using:BethesdaMultitool">

  <Grid VerticalAlignment="Stretch">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="400" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="280" MinWidth="220" />
    </Grid.ColumnDefinitions>
    <!--  Options for this workflow remain visible beside its inputs.  -->
    <Border
      x:Name="ToolOptionsPanel" Grid.Column="2" Width="Auto" HorizontalAlignment="Stretch"
      Style="{StaticResource ToolOptionsBorderStyle}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <TextBlock live:RuntimeLocalization.Uid="Workflow_Options" Style="{StaticResource SubtitleTextBlockStyle}" />
          <StackPanel Spacing="4">
            <TextBlock Text="Output" FontWeight="SemiBold" FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <CheckBox
              x:Name="PreserveStructureCheckBox"
              live:RuntimeLocalization.Uid="Checkbox_PreserveFolderStructure"
              MinWidth="0"
              IsChecked="True" />
            <CheckBox
              x:Name="OverwriteExistingCheckBox"
              live:RuntimeLocalization.Uid="Checkbox_OverwriteExisting"
              MinWidth="0" />
            <CheckBox
              x:Name="VerboseOutputCheckBox"
              live:RuntimeLocalization.Uid="Checkbox_VerboseOutput"
              MinWidth="0" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <toolkit:GridSplitter Grid.Column="1" Style="{StaticResource MultitoolColumnSplitterStyle}" />

    <!--  Main content  -->
    <Grid Padding="16"
          VerticalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header row: Title + Select buttons (outside card) -->
      <Grid Grid.Row="0"
            Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Style="{StaticResource TabHeaderStackPanelStyle}">
          <TextBlock
            live:RuntimeLocalization.Uid="Header_DdxConverter"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock
            live:RuntimeLocalization.Uid="Subtitle_DdxConvBy"
            Style="{StaticResource TabSubtitleStyle}" />
        </StackPanel>
        <StackPanel
          Grid.Column="1"
          Style="{StaticResource SelectButtonsPanelStyle}">
          <Button
            live:RuntimeLocalization.Uid="Button_SelectAll"
            Click="SelectAllButton_Click" />
          <Button
            live:RuntimeLocalization.Uid="Button_SelectNone"
            Click="SelectNoneButton_Click" />
        </StackPanel>
      </Grid>

      <!-- Files List Card -->
      <Border
        Grid.Row="1"
        VerticalAlignment="Stretch"
        Style="{StaticResource CardBorderStyle}">
        <Grid VerticalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Column headers -->
          <Grid Grid.Row="0"
                Style="{StaticResource ColumnHeaderGridStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       FontWeight="SemiBold"
                       Text="" />
            <Button
              Grid.Column="1"
              Style="{StaticResource SortableColumnHeaderButtonStyle}"
              AutomationProperties.Name="Sort by file path"
              Click="SortByFilePath_Click">
              <StackPanel Orientation="Horizontal"
                          Spacing="4">
                <TextBlock live:RuntimeLocalization.Uid="Col_FilePath" FontWeight="SemiBold" />
                <FontIcon
                  x:Name="FilePathSortIcon"
                  Style="{StaticResource SortIconStyle}" />
              </StackPanel>
            </Button>
            <Button
              Grid.Column="2"
              Style="{StaticResource SortableColumnHeaderButtonStyle}"
              AutomationProperties.Name="Sort by size"
              Click="SortBySize_Click">
              <StackPanel Orientation="Horizontal"
                          Spacing="4">
                <TextBlock live:RuntimeLocalization.Uid="Col_Size" FontWeight="SemiBold" />
                <FontIcon
                  x:Name="SizeSortIcon"
                  Style="{StaticResource SortIconStyle}" />
              </StackPanel>
            </Button>
            <Button
              Grid.Column="3"
              Style="{StaticResource SortableColumnHeaderButtonStyle}"
              AutomationProperties.Name="Sort by format"
              Click="SortByFormat_Click">
              <StackPanel Orientation="Horizontal"
                          Spacing="4">
                <TextBlock live:RuntimeLocalization.Uid="Col_Format" FontWeight="SemiBold" />
                <FontIcon
                  x:Name="FormatSortIcon"
                  Style="{StaticResource SortIconStyle}" />
              </StackPanel>
            </Button>
            <Button
              Grid.Column="4"
              Style="{StaticResource SortableColumnHeaderButtonStyle}"
              AutomationProperties.Name="Sort by status"
              Click="SortByStatus_Click">
              <StackPanel Orientation="Horizontal"
                          Spacing="4">
                <TextBlock live:RuntimeLocalization.Uid="Col_Status" FontWeight="SemiBold" />
                <FontIcon
                  x:Name="StatusSortIcon"
                  Style="{StaticResource SortIconStyle}" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Files ListView -->
          <ListView
            x:Name="DdxFilesListView"
            Grid.Row="1"
            AutomationProperties.Name="DDX files to convert"
            Style="{StaticResource FileListViewStyle}">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:DdxFileEntry">
                <Grid Style="{StaticResource ListItemRowGridStyle}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="200" />
                  </Grid.ColumnDefinitions>
                  <CheckBox
                    Grid.Column="0"
                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Bind RelativePath}" />
                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind RelativePath}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind FullPath}" />
                  <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{x:Bind FileSizeDisplay}" />
                  <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{x:Bind FormatColor}"
                    Text="{x:Bind FormatDescription}" />
                  <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Foreground="{x:Bind StatusColor, Mode=OneWay}"
                    Text="{x:Bind Status, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <!--  Progress Bar (above I/O)  -->
      <ProgressBar
        x:Name="ConversionProgressBar"
        Grid.Row="2"
        Style="{StaticResource TabProgressBarStyle}" />

      <!-- Input/Output Section -->
      <Grid
        Grid.Row="3"
        Style="{StaticResource IoSectionGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Input Directory -->
        <TextBlock
          x:Name="DdxInputDirectoryLabel"
          live:RuntimeLocalization.Uid="Label_InputDirectory"
          Grid.Row="0"
          Grid.Column="0"
          Style="{StaticResource IoLabelStyle}" />
        <TextBox
          x:Name="InputDirectoryTextBox"
          live:RuntimeLocalization.Uid="Input_DdxInputDir"
          Grid.Row="0"
          Grid.Column="1"
          Style="{StaticResource IoTextBoxStyle}"
          AutomationProperties.LabeledBy="{Binding ElementName=DdxInputDirectoryLabel}"
          TextChanged="InputDirectoryTextBox_TextChanged" />
        <Button
          live:RuntimeLocalization.Uid="Button_Browse"
          Grid.Row="0"
          Grid.Column="2"
          AutomationProperties.Name="Browse for input directory"
          Click="BrowseInputButton_Click" />
        <Button
          x:Name="ConvertButton"
          live:RuntimeLocalization.Uid="Button_Convert"
          Grid.Row="0"
          Grid.Column="3"
          MinWidth="120"
          Margin="8,0,0,0"
          Click="ConvertButton_Click"
          IsEnabled="False"
          Style="{StaticResource AccentButtonStyle}" />

        <!-- Output Directory -->
        <TextBlock
          x:Name="DdxOutputDirectoryLabel"
          live:RuntimeLocalization.Uid="Label_OutputDirectory"
          Grid.Row="1"
          Grid.Column="0"
          Style="{StaticResource IoLabelStyle}" />
        <TextBox
          x:Name="OutputDirectoryTextBox"
          live:RuntimeLocalization.Uid="Input_ConvertOutputDir"
          Grid.Row="1"
          Grid.Column="1"
          Style="{StaticResource IoTextBoxStyle}"
          AutomationProperties.LabeledBy="{Binding ElementName=DdxOutputDirectoryLabel}"
          TextChanged="OutputDirectoryTextBox_TextChanged" />
        <Button
          live:RuntimeLocalization.Uid="Button_Browse"
          Grid.Row="1"
          Grid.Column="2"
          AutomationProperties.Name="Browse for output directory"
          Click="BrowseOutputButton_Click" />
        <Button
          x:Name="CancelButton"
          live:RuntimeLocalization.Uid="Button_Cancel"
          Grid.Row="1"
          Grid.Column="3"
          Margin="8,0,0,0"
          HorizontalAlignment="Stretch"
          Click="CancelButton_Click"
          IsEnabled="False" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
