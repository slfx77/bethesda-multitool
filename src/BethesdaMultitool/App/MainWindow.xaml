<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:live="using:BethesdaMultitool.Localization" xmlns:tabs="using:BethesdaMultitool" x:Class="BethesdaMultitool.MainWindow" Title="Bethesda Multitool" xmlns:shell="using:Slfx77.Multitool.WinUI.Shell">
  <Grid x:Name="WindowRoot">
    <!-- The help shortcut sits in the native caption region beside the system buttons, not in a passthrough area:
         pointer hover, press and tap arrive through the window's non-client input source and are mirrored onto this
         button, so the caption buttons and the shortcut share one native hover state machine. Keyboard focus, F1,
         Space/Enter and UI Automation still use the ordinary button. Width, height and position follow the native
         caption metrics in code. It is declared first so keyboard focus reaches it before the workspace, and drawn
         above the shell by its ZIndex. -->
    <Button x:Name="HelpShortcutsButton" Canvas.ZIndex="1" AutomationProperties.Name="Keyboard shortcuts"
            AutomationProperties.HelpText="Show keyboard shortcuts (F1)" ToolTipService.ToolTip="Keyboard shortcuts (F1)"
            MinWidth="0" MinHeight="0" Padding="0" Margin="0" CornerRadius="0"
            HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
            IsHitTestVisible="False" Click="HelpShortcuts_Click" UseSystemFocusVisuals="True"
            Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
      <FontIcon Glyph="" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"/>
    </Button>
  <shell:ApplicationShell x:Name="ApplicationFrame" Title="Bethesda Multitool" KeyboardAcceleratorPlacementMode="Hidden">
    <shell:ApplicationShell.Resources>
      <!-- Construction fallback; code keeps this native drag reservation equal to the overlaid help shortcut so title content never runs under it. -->
      <x:Double x:Key="TitleBarMinDragRegionWidth">48</x:Double>
    </shell:ApplicationShell.Resources>
    <shell:ApplicationShell.IconSource>
      <BitmapIconSource UriSource="ms-appx:///Assets/AppIcon.png" ShowAsMonochrome="False"/>
    </shell:ApplicationShell.IconSource>
    <shell:ApplicationShell.ToolItems>
      <NavigationViewItemSeparator/>
      <NavigationViewItemHeader live:RuntimeLocalization.Uid="NavHeader_Assets"/>
      <NavigationViewItem live:RuntimeLocalization.Uid="Nav_BsaExtractor" Tag="BsaExtractor">
        <NavigationViewItem.Icon>
          <FontIcon Glyph=""/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem live:RuntimeLocalization.Uid="Nav_NifConverter" Tag="NifConverter">
        <NavigationViewItem.Icon>
          <FontIcon Glyph=""/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItemSeparator/>
      <NavigationViewItemHeader live:RuntimeLocalization.Uid="NavHeader_Recovery"/>
      <NavigationViewItem live:RuntimeLocalization.Uid="Explore_CarverNavigation" Tag="RecoveryFile">
        <NavigationViewItem.Icon>
          <FontIcon Glyph=""/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem live:RuntimeLocalization.Uid="Nav_Repacker" Tag="Repacker">
        <NavigationViewItem.Icon>
          <FontIcon Glyph=""/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem live:RuntimeLocalization.Uid="Nav_DdxConverter" Tag="DdxConverter">
        <NavigationViewItem.Icon>
          <FontIcon Glyph=""/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem live:RuntimeLocalization.Uid="Nav_DmpToEsmConverter" Tag="DmpToEsmConverter">
        <NavigationViewItem.Icon>
          <FontIcon Glyph=""/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem live:RuntimeLocalization.Uid="Nav_BatchMode" Tag="BatchMode">
        <NavigationViewItem.Icon>
          <FontIcon Glyph=""/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </shell:ApplicationShell.ToolItems>
    <shell:ApplicationShell.FooterItems>
      <NavigationViewItem live:RuntimeLocalization.Uid="Nav_Diagnostics" Tag="Diagnostics">
        <NavigationViewItem.Icon>
          <FontIcon Glyph=""/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </shell:ApplicationShell.FooterItems>
    <shell:ApplicationShell.KeyboardAccelerators>
      <KeyboardAccelerator Key="F1" Invoked="F1_ShortcutsDialog_Invoked"/>
    </shell:ApplicationShell.KeyboardAccelerators>
    <shell:ApplicationShell.TitleActions>
        <StackPanel x:Name="NavButtonPanel" Orientation="Horizontal" Visibility="Collapsed">
          <Button x:Name="NavBackButton" Width="28" Height="24" Padding="0" VerticalAlignment="Center" IsEnabled="False" Click="NavBack_Click" ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" AutomationProperties.HelpText="Go back to the previously viewed tab (Alt+Left)" Background="Transparent" BorderBrush="Transparent">
            <FontIcon Glyph="" FontSize="11"/>
          </Button>
          <Button x:Name="NavForwardButton" Width="28" Height="24" Padding="0" Margin="2,0,0,0" VerticalAlignment="Center" IsEnabled="False" Click="NavForward_Click" ToolTipService.ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward" AutomationProperties.HelpText="Go forward to the next tab in navigation history (Alt+Right)" Background="Transparent" BorderBrush="Transparent">
            <FontIcon Glyph="" FontSize="11"/>
          </Button>
        </StackPanel>
    </shell:ApplicationShell.TitleActions>
    <shell:ApplicationShell.Workspace>
      <Grid VerticalAlignment="Stretch">
        <tabs:ExploreTab x:Name="ExploreTabContent" VerticalAlignment="Stretch" Visibility="Visible"/>
        <tabs:SingleFileTab x:Name="RecoveryFileTabContent" VerticalAlignment="Stretch" Visibility="Collapsed"/>
        <tabs:BatchModeTab x:Name="BatchModeTabContent" VerticalAlignment="Stretch" Visibility="Collapsed"/>
        <tabs:NifConverterTab x:Name="NifConverterTabContent" VerticalAlignment="Stretch" Visibility="Collapsed"/>
        <tabs:DdxConverterTab x:Name="DdxConverterTabContent" VerticalAlignment="Stretch" Visibility="Collapsed"/>
        <tabs:BsaExtractorTab x:Name="BsaExtractorTabContent" VerticalAlignment="Stretch" Visibility="Collapsed"/>
        <tabs:RepackerTab x:Name="RepackerTabContent" VerticalAlignment="Stretch" Visibility="Collapsed"/>
        <tabs:DmpToEsmConverterTab x:Name="DmpToEsmConverterTabContent" VerticalAlignment="Stretch" Visibility="Collapsed"/>
        <tabs:DiagnosticsTab x:Name="DiagnosticsTabContent" VerticalAlignment="Stretch" Visibility="Collapsed"/>
        <tabs:ApplicationSettingsTab x:Name="SettingsTabContent" VerticalAlignment="Stretch" Visibility="Collapsed"/>
      </Grid>
    </shell:ApplicationShell.Workspace>
  </shell:ApplicationShell>
  </Grid>
</Window>
