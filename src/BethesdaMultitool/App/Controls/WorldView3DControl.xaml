<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="BethesdaMultitool.WorldView3DControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:BethesdaMultitool">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar — mirrors WorldMapControl's worldspace picker. -->
    <Grid Grid.Row="0" Padding="0,0,0,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox x:Name="WorldspaceComboBox" MinWidth="220"
                  SelectionChanged="WorldspaceComboBox_SelectionChanged"
                  AutomationProperties.Name="Worldspace"
                  PlaceholderText="Select Worldspace" />
        <Button x:Name="InteriorsButton" Content="Interiors" IsEnabled="False"
                Click="InteriorsButton_Click"
                ToolTipService.ToolTip="Browse interior cells" />
      </StackPanel>
      <!-- The former toolbar controls (Lighting / Layers / Visibility / Projection dropdowns and the
           Export button) all live in the host's right-panel tabs now: Settings = WorldView3DSettingsPanel
           and Export = WorldView3DExportPanel, both constructed + wired by this control. -->
    </Grid>

    <!-- 3D viewport — SwapChainPanel + status overlay + HUD. -->
    <Grid Grid.Row="1">
      <SwapChainPanel x:Name="RenderPanel"
                      IsTabStop="True"
                      AutomationProperties.Name="3D worldspace view" />
      <TextBlock x:Name="StatusOverlay"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="14"
                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                 AutomationProperties.Name="3D view status"
                 Visibility="Collapsed" />
      <!-- Dark, baked-alpha background (NOT Border Opacity, which would dim the text too) so the
           overlay stays readable over bright snow / sky. Fixed light foreground for the same reason. -->
      <Border x:Name="HudPanel"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="8" Padding="8,4"
              CornerRadius="4"
              Background="#D8101014">
        <TextBlock x:Name="HudText"
                   FontFamily="Consolas" FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="#FFE6E6E6"
                   AutomationProperties.Name="3D view HUD"
                   Text="" />
      </Border>

      <!-- 90°-snap rotate buttons for the projection modes — sit to the LEFT of the diagnostics toggle
           (extra right margin clears it). Collapsed in perspective mode (SetProjectionMode toggles it). -->
      <StackPanel x:Name="ProjectionSnapPanel" Orientation="Horizontal" Spacing="4"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="8,8,52,8" Visibility="Collapsed">
        <Button x:Name="RotateLeftButton" Padding="6" MinWidth="0"
                ToolTipService.ToolTip="Rotate view 90° left"
                AutomationProperties.Name="Rotate view 90 degrees left"
                Click="RotateLeftButton_Click">
          <FontIcon Glyph="&#xE80D;" FontSize="14" /> <!-- RotateMapLeft: curved CCW rotate arrow -->

        </Button>
        <Button x:Name="RotateRightButton" Padding="6" MinWidth="0"
                ToolTipService.ToolTip="Rotate view 90° right"
                AutomationProperties.Name="Rotate view 90 degrees right"
                Click="RotateRightButton_Click">
          <FontIcon Glyph="&#xE80C;" FontSize="14" /> <!-- RotateMapRight: curved CW rotate arrow -->

        </Button>
      </StackPanel>

      <!-- Hide/show toggle for the diagnostics overlay (top-right, away from the HUD). Stays visible
           when the HUD is hidden so it can be brought back. -->
      <ToggleButton x:Name="HudToggleButton"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="8" Padding="6" MinWidth="0"
                    IsChecked="True"
                    ToolTipService.ToolTip="Show/hide the diagnostics overlay"
                    AutomationProperties.Name="Show/hide diagnostics overlay"
                    Checked="HudToggleButton_Changed" Unchecked="HudToggleButton_Changed">
        <FontIcon Glyph="&#xE946;" FontSize="14" />
      </ToggleButton>

      <!-- Interior cell browser — the shared CellListControl (same list the 2D viewer uses). Overlays the
           viewport while browsing; picking a cell loads it into the 3D scene and hides the panel. -->
      <Grid x:Name="CellBrowserPanel" Visibility="Collapsed" Padding="8"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,4" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Interior cells" VerticalAlignment="Center"
                     FontWeight="SemiBold" />
          <Button Grid.Column="1" x:Name="CellBrowserCloseButton" Content="Close"
                  Click="CellBrowserCloseButton_Click"
                  AutomationProperties.Name="Close interior browser" />
        </Grid>
        <local:CellListControl x:Name="CellList" Grid.Row="1" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
