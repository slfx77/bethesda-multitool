<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="BethesdaMultitool.WorldView3DControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar — mirrors WorldMapControl's worldspace picker. -->
    <Grid Grid.Row="0" Padding="0,0,0,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox x:Name="WorldspaceComboBox" MinWidth="220"
                  SelectionChanged="WorldspaceComboBox_SelectionChanged"
                  AutomationProperties.Name="Worldspace"
                  PlaceholderText="Select Worldspace" />
        <Button x:Name="InteriorsButton" Content="Interiors" IsEnabled="False"
                Click="InteriorsButton_Click"
                ToolTipService.ToolTip="Browse interior cells" />
      </StackPanel>
      <!-- Control bar — grouped submenus (Lighting / Layers / Visibility). Each layer toggle keeps its
           x:Name + Checked/Unchecked handler so the 1–9 keyboard shortcuts (OnRenderPanelKeyDown) still
           flip them. CheckBoxes are content-bearing, satisfying the accessibility ratchet. -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                  VerticalAlignment="Center" HorizontalAlignment="Right">

        <!-- Lighting: on/off toggle (top) + time-of-day + weather -->
        <DropDownButton AutomationProperties.Name="Lighting menu"
                        ToolTipService.ToolTip="Lighting — on/off, time of day, weather">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE706;" FontSize="14" />
            <TextBlock Text="Lighting" />
          </StackPanel>
          <DropDownButton.Flyout>
            <Flyout>
              <StackPanel Spacing="10" MinWidth="260">
                <ToggleSwitch x:Name="LightingToggle" IsOn="True" Header="Lighting"
                              OnContent="On" OffContent="Off"
                              AutomationProperties.Name="Lighting"
                              ToolTipService.ToolTip="Toggle scene lighting (press 8)"
                              Toggled="LightingToggle_Changed" />
                <ToggleSwitch x:Name="FogToggle" IsOn="True" Header="Fog"
                              OnContent="On" OffContent="Off"
                              AutomationProperties.Name="Fog"
                              ToolTipService.ToolTip="Toggle distance fog (press 0)"
                              Toggled="FogToggle_Changed" />
                <TextBlock Text="Time of day" FontWeight="SemiBold" />
                <Slider x:Name="TimeSlider" Minimum="0" Maximum="24" StepFrequency="0.1" Value="12"
                        AutomationProperties.Name="Time of day"
                        ToolTipService.ToolTip="Time of day (0–24h) — drives lighting + sky colors"
                        ValueChanged="TimeSlider_ValueChanged" />
                <TextBlock Text="Weather" FontWeight="SemiBold" />
                <ComboBox x:Name="WeatherComboBox" HorizontalAlignment="Stretch"
                          SelectionChanged="WeatherComboBox_SelectionChanged"
                          AutomationProperties.Name="Weather"
                          ToolTipService.ToolTip="Weather — drives the sky / ambient / sun / fog colors"
                          PlaceholderText="Weather" />
              </StackPanel>
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>

        <!-- Layers: cell grid / terrain textures / vertex colors / nav-mesh.
             "Terrain textures" and "Vertex colors" are independent terrain shader toggles. -->
        <DropDownButton AutomationProperties.Name="Layers menu" ToolTipService.ToolTip="Layers">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE81E;" FontSize="14" />
            <TextBlock Text="Layers" />
          </StackPanel>
          <DropDownButton.Flyout>
            <Flyout>
              <StackPanel Spacing="8" MinWidth="220">
                <CheckBox x:Name="CellsCheckBox" IsChecked="False" Content="Cell grid"
                          AutomationProperties.Name="Cell grid"
                          ToolTipService.ToolTip="Show the cell grid overlay (press 1)"
                          Checked="CellsCheckBox_Changed" Unchecked="CellsCheckBox_Changed" />
                <CheckBox x:Name="TerrainTexturesToggle" IsChecked="True" Content="Terrain textures"
                          AutomationProperties.Name="Terrain textures"
                          ToolTipService.ToolTip="Show terrain diffuse textures (off = flat shaded)"
                          Checked="TerrainTexturesToggle_Changed" Unchecked="TerrainTexturesToggle_Changed" />
                <CheckBox x:Name="VertexColorsToggle" IsChecked="True" Content="Vertex colors"
                          AutomationProperties.Name="Vertex colors"
                          ToolTipService.ToolTip="Apply per-vertex terrain color tint (press 4)"
                          Checked="VertexColorsToggle_Changed" Unchecked="VertexColorsToggle_Changed" />
                <CheckBox x:Name="NavMeshCheckBox" IsChecked="False" Content="Nav mesh"
                          AutomationProperties.Name="Nav mesh"
                          ToolTipService.ToolTip="Show the navmesh overlay (press 6)"
                          Checked="NavMeshCheckBox_Changed" Unchecked="NavMeshCheckBox_Changed" />
              </StackPanel>
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>

        <!-- Visibility: terrain / meshes / water / skybox / fog / markers / activators / disabled -->
        <DropDownButton AutomationProperties.Name="Visibility menu" ToolTipService.ToolTip="Visibility">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE890;" FontSize="14" />
            <TextBlock Text="Visibility" />
          </StackPanel>
          <DropDownButton.Flyout>
            <Flyout>
              <StackPanel Spacing="8" MinWidth="240">
                <CheckBox x:Name="TerrainToggle" IsChecked="True" Content="Terrain"
                          AutomationProperties.Name="Terrain"
                          ToolTipService.ToolTip="Show terrain (press 2)"
                          Checked="TerrainToggle_Changed" Unchecked="TerrainToggle_Changed" />
                <CheckBox x:Name="RefsToggle" IsChecked="True" Content="Meshes"
                          AutomationProperties.Name="Placed objects"
                          ToolTipService.ToolTip="Show placed-object meshes (press 5)"
                          Checked="RefsToggle_Changed" Unchecked="RefsToggle_Changed" />
                <CheckBox x:Name="WaterCheckBox" IsChecked="True" Content="Water"
                          AutomationProperties.Name="Water"
                          ToolTipService.ToolTip="Show water surfaces (press 3)"
                          Checked="WaterCheckBox_Changed" Unchecked="WaterCheckBox_Changed" />
                <CheckBox x:Name="SkyboxToggle" IsChecked="True" Content="Skybox"
                          AutomationProperties.Name="Skybox"
                          ToolTipService.ToolTip="Show the sky (press 9)"
                          Checked="SkyboxToggle_Changed" Unchecked="SkyboxToggle_Changed" />
                <CheckBox x:Name="EditorMarkersCheckBox" IsChecked="False" Content="Editor markers"
                          AutomationProperties.Name="Editor markers"
                          ToolTipService.ToolTip="Show editor/engine markers (XMarkers, travel/door markers)"
                          Checked="EditorMarkersCheckBox_Changed" Unchecked="EditorMarkersCheckBox_Changed" />
                <CheckBox x:Name="ActivatorsCheckBox" IsChecked="True" Content="Activators"
                          AutomationProperties.Name="Activators"
                          ToolTipService.ToolTip="Show activator objects (levers, terminals, buttons)"
                          Checked="ActivatorsCheckBox_Changed" Unchecked="ActivatorsCheckBox_Changed" />
                <CheckBox x:Name="DisabledCheckBox" IsChecked="False" Content="Initially-disabled objects"
                          AutomationProperties.Name="Initially-disabled objects"
                          ToolTipService.ToolTip="Show objects flagged initially-disabled (press 7)"
                          Checked="DisabledCheckBox_Changed" Unchecked="DisabledCheckBox_Changed" />
                <CheckBox x:Name="CollisionCheckBox" IsChecked="False" Content="Havok collision"
                          AutomationProperties.Name="Havok collision"
                          ToolTipService.ToolTip="Overlay each object's walk-mode collision mesh as a green wireframe (compare against the rendered meshes)"
                          Checked="CollisionCheckBox_Changed" Unchecked="CollisionCheckBox_Changed" />
              </StackPanel>
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>

      </StackPanel>
    </Grid>

    <!-- 3D viewport — SwapChainPanel + status overlay + HUD. -->
    <Grid Grid.Row="1">
      <SwapChainPanel x:Name="RenderPanel"
                      IsTabStop="True"
                      AutomationProperties.Name="3D worldspace view" />
      <TextBlock x:Name="StatusOverlay"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="14"
                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                 AutomationProperties.Name="3D view status"
                 Visibility="Collapsed" />
      <!-- Dark, baked-alpha background (NOT Border Opacity, which would dim the text too) so the
           overlay stays readable over bright snow / sky. Fixed light foreground for the same reason. -->
      <Border x:Name="HudPanel"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="8" Padding="8,4"
              CornerRadius="4"
              Background="#D8101014">
        <TextBlock x:Name="HudText"
                   FontFamily="Consolas" FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="#FFE6E6E6"
                   AutomationProperties.Name="3D view HUD"
                   Text="" />
      </Border>

      <!-- Hide/show toggle for the diagnostics overlay (top-right, away from the HUD). Stays visible
           when the HUD is hidden so it can be brought back. -->
      <ToggleButton x:Name="HudToggleButton"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="8" Padding="6" MinWidth="0"
                    IsChecked="True"
                    ToolTipService.ToolTip="Show/hide the diagnostics overlay"
                    AutomationProperties.Name="Show/hide diagnostics overlay"
                    Checked="HudToggleButton_Changed" Unchecked="HudToggleButton_Changed">
        <FontIcon Glyph="&#xE946;" FontSize="14" />
      </ToggleButton>

      <!-- Interior cell browser — reuses the 2D viewer's searchable/filterable grouped list
           (WorldMapCellBrowser). Overlays the viewport while browsing; picking a cell loads it
           into the 3D scene and hides the panel. -->
      <Grid x:Name="CellBrowserPanel" Visibility="Collapsed" Padding="8"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,4" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Interior cells" VerticalAlignment="Center"
                     FontWeight="SemiBold" />
          <Button Grid.Column="1" x:Name="CellBrowserCloseButton" Content="Close"
                  Click="CellBrowserCloseButton_Click"
                  AutomationProperties.Name="Close interior browser" />
        </Grid>
        <TextBox x:Name="CellSearchBox" Grid.Row="1" PlaceholderText="Search cells..."
                 AutomationProperties.Name="Search cells"
                 TextChanged="CellSearchBox_TextChanged" Margin="0,0,0,4" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
          <CheckBox x:Name="FilterHasObjects" Content="Has objects"
                    Checked="CellFilter_Changed" Unchecked="CellFilter_Changed" />
          <CheckBox x:Name="FilterNamedOnly" Content="Named only"
                    Checked="CellFilter_Changed" Unchecked="CellFilter_Changed" />
          <ComboBox x:Name="CellSortCombo" MinWidth="120" VerticalAlignment="Center"
                    SelectedIndex="0"
                    AutomationProperties.Name="Sort cells"
                    ToolTipService.ToolTip="Sort cells within each group"
                    SelectionChanged="CellSortCombo_SelectionChanged">
            <ComboBoxItem Content="Sort: Grid" />
            <ComboBoxItem Content="Sort: Object count" />
          </ComboBox>
          <TextBlock x:Name="CellBrowserCountText" VerticalAlignment="Center" FontSize="11"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ListView x:Name="CellListView" Grid.Row="3"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  AutomationProperties.Name="Interior cells"
                  ItemClick="CellListView_ItemClick">
          <ListView.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Key}" FontSize="13" FontWeight="Bold"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListView.GroupStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="4,2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" FontFamily="Consolas"
                           Text="{Binding GridLabel}" />
                <TextBlock Grid.Column="1" FontSize="11"
                           Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" FontSize="11" FontFamily="Consolas"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{Binding ObjectCount}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
