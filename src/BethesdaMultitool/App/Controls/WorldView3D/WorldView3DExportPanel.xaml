<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="BethesdaMultitool.WorldView3DExportPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:BethesdaMultitool">

  <!-- 3D worldspace export, shown in the host's right-panel "Export" tab (replaces the old modal
       MapExport3DDialog + toolbar button). Pure declarative XAML: WorldView3DControl constructs this
       panel, reaches the internal fields, and subscribes every control's events in WireExportPanel() —
       no logic lives here. Include-checkbox defaults mirror the viewer's _show* initializers; the owner
       re-seeds them from the live view when a worldspace loads (independent thereafter). -->
  <StackPanel Spacing="8">

    <!-- ============================== Projection & framing ============================== -->
    <Expander x:Name="ProjectionExpander" IsExpanded="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <TextBlock Text="Projection" FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level2" />
      </Expander.Header>
      <StackPanel Spacing="10">
        <ComboBox x:Name="ProjectionComboBox" x:FieldModifier="internal"
                  Header="Projection" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Projection"
                  ToolTipService.ToolTip="Camera projection for the export image" />
        <ComboBox x:Name="DirectionComboBox" x:FieldModifier="internal"
                  Header="Direction (top of image)" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Direction" />

        <StackPanel Spacing="4">
          <TextBlock Text="Scale" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="1× renders a player-height object (≈128 units) 64 px tall."
                     FontSize="11" TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="Scale025Button" x:FieldModifier="internal" Content="0.25x" Tag="0.25"
                    AutomationProperties.Name="Quarter scale"
                    ToolTipService.ToolTip="Player ≈ 16 px tall" />
            <Button x:Name="Scale05Button" x:FieldModifier="internal" Content="0.5x" Tag="0.5"
                    AutomationProperties.Name="Half scale"
                    ToolTipService.ToolTip="Player ≈ 32 px tall" />
            <Button x:Name="Scale1Button" x:FieldModifier="internal" Content="1x" Tag="1"
                    AutomationProperties.Name="Native scale"
                    ToolTipService.ToolTip="Player ≈ 64 px tall" />
            <Button x:Name="Scale2Button" x:FieldModifier="internal" Content="2x" Tag="2"
                    AutomationProperties.Name="Double scale"
                    ToolTipService.ToolTip="Player ≈ 128 px tall" />
            <Button x:Name="Scale4Button" x:FieldModifier="internal" Content="4x" Tag="4"
                    AutomationProperties.Name="Quadruple scale"
                    ToolTipService.ToolTip="Player ≈ 256 px tall" />
          </StackPanel>
        </StackPanel>

        <ToggleSwitch x:Name="ShowFramingToggle" x:FieldModifier="internal" IsOn="False"
                      Header="Show framing in view" OnContent="On" OffContent="Off"
                      AutomationProperties.Name="Show framing in view"
                      ToolTipService.ToolTip="Outline the world region + view angle the export will capture as an overlay in the 3D view" />
      </StackPanel>
    </Expander>

    <!-- ============================== Include ============================== -->
    <Expander x:Name="IncludeExpander"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <TextBlock Text="Include" FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level2" />
      </Expander.Header>
      <StackPanel Spacing="8">
        <CheckBox x:Name="TerrainCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Terrain"
                  AutomationProperties.Name="Terrain" />
        <CheckBox x:Name="MeshesCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Meshes (placed objects)"
                  AutomationProperties.Name="Meshes" />
        <CheckBox x:Name="WaterCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Water"
                  AutomationProperties.Name="Water" />
        <CheckBox x:Name="TreesCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Trees"
                  AutomationProperties.Name="Trees" />
        <CheckBox x:Name="GrassCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Grass"
                  AutomationProperties.Name="Grass" />
        <CheckBox x:Name="ActivatorsCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Activators"
                  AutomationProperties.Name="Activators" />
        <CheckBox x:Name="MarkersCheckBox" x:FieldModifier="internal" IsChecked="False" Content="Editor markers"
                  AutomationProperties.Name="Editor markers" />
        <CheckBox x:Name="DisabledCheckBox" x:FieldModifier="internal" IsChecked="False" Content="Initially-disabled objects"
                  AutomationProperties.Name="Initially-disabled objects" />
        <CheckBox x:Name="NavMeshCheckBox" x:FieldModifier="internal" IsChecked="False" Content="Nav mesh"
                  AutomationProperties.Name="Nav mesh" />
        <CheckBox x:Name="CollisionCheckBox" x:FieldModifier="internal" IsChecked="False" Content="Collision mesh"
                  AutomationProperties.Name="Collision mesh" />
        <CheckBox x:Name="GridCheckBox" x:FieldModifier="internal" IsChecked="False" Content="Cell grid"
                  AutomationProperties.Name="Cell grid" />
        <CheckBox x:Name="LightingCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Lighting"
                  AutomationProperties.Name="Lighting" />
        <CheckBox x:Name="FogCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Fog"
                  AutomationProperties.Name="Fog" />
      </StackPanel>
    </Expander>

    <!-- ============================== Output ============================== -->
    <Expander x:Name="OutputExpander" IsExpanded="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <TextBlock Text="Output" FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level2" />
      </Expander.Header>
      <StackPanel Spacing="10">
        <CheckBox x:Name="TiledCheckBox" x:FieldModifier="internal" IsChecked="True"
                  Content="Tiled high-res (multiple PNGs + manifest)"
                  AutomationProperties.Name="Tiled high-res" />
        <TextBlock x:Name="OutputSizeText" x:FieldModifier="internal" FontSize="11" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel Spacing="4">
          <TextBlock Text="Folder" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="FolderTextBox" x:FieldModifier="internal" Width="240"
                     IsSpellCheckEnabled="False"
                     AutomationProperties.Name="Output folder"
                     ToolTipService.ToolTip="Destination folder for the exported PNG(s)" />
            <Button x:Name="BrowseFolderButton" x:FieldModifier="internal" Content="Browse…"
                    AutomationProperties.Name="Browse for output folder" />
          </StackPanel>
        </StackPanel>

        <TextBox x:Name="FileNameTextBox" x:FieldModifier="internal" Header="File name"
                 IsSpellCheckEnabled="False"
                 AutomationProperties.Name="Output file name"
                 ToolTipService.ToolTip="Base name for the PNG (tiled runs append _r{row}_c{col} + a manifest)" />

        <Button x:Name="ExportRunButton" x:FieldModifier="internal" Content="Export…"
                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"
                AutomationProperties.Name="Export"
                ToolTipService.ToolTip="Render and save the export to the chosen folder" />
      </StackPanel>
    </Expander>

  </StackPanel>
</UserControl>
