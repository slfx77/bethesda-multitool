<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="BethesdaMultitool.WorldView3DSettingsPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:BethesdaMultitool">

  <UserControl.Resources>
    <local:DrawDistanceTooltipConverter x:Key="DrawDistanceTooltip" />
    <local:HeatmapRangeTooltipConverter x:Key="HeatmapRangeTooltip" />
  </UserControl.Resources>

  <!-- 3D viewer settings, shown in the host's right-panel "Settings" tab (replaces the old toolbar
       dropdowns). WorldView3DControl constructs this panel, reaches the internal fields, and
       subscribes every control's events in WireSettingsPanel(); code-behind owns view-only layout
       warmup and dependent-control availability. IsChecked/IsOn defaults describe ordinary startup
       without environment overrides; applying dependency state never rewrites those preferences. -->
  <StackPanel Spacing="8">

    <!-- ============================== Lighting ============================== -->
    <Expander x:Name="LightingExpander" IsExpanded="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE706;" FontSize="14" />
          <TextBlock Text="Lighting" FontWeight="SemiBold"
                     AutomationProperties.HeadingLevel="Level2" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="10">
        <local:LightingControlsPanel x:Name="Lighting" x:FieldModifier="internal" />

        <ToggleSwitch x:Name="PlacedLightsToggle" x:FieldModifier="internal" IsOn="True"
                      Header="Placed lights" OnContent="On" OffContent="Off"
                      AutomationProperties.Name="Placed lights"
                      ToolTipService.ToolTip="Illuminate the scene with placed LIGH point emitters" />

        <!-- Post-processing: imagespace grade — hidden for games without the engine HDR stage
             (Morrowind); the owner gates visibility per loaded game in LoadData. The HDR/Bloom
             switches this section used to hold became the Video expander's retail three-way
             Screen effects radio (None/Bloom/HDR). -->
        <StackPanel x:Name="TonemapSection" x:FieldModifier="internal" Spacing="10">
          <Border Height="1" Margin="0,2,0,2"
                  Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <TextBlock Text="Post-processing" FontWeight="SemiBold"
                     AutomationProperties.HeadingLevel="Level2" />
          <ComboBox x:Name="ImagespaceComboBox" x:FieldModifier="internal"
                    Header="Imagespace" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Imagespace"
                    ToolTipService.ToolTip="Imagespace color grade: (Automatic) follows the cell/worldspace (e.g. the FNV golden desert filter), (None) renders a neutral grade, or force a specific imagespace" />
        </StackPanel>
      </StackPanel>
    </Expander>

    <!-- ============================== Video ============================== -->
    <!-- Retail-style video options (the game's launcher/in-game set), one control per engine
         setting; tooltips cite the ini names. Per-game visibility comes from
         VideoSettingsProfile.ForGame via ApplyVideoProfile (never hard-coded game compares).
         Defaults describe retail Ultra High: HDR + everything on. The toggles are latent
         preferences ANDed with the Shadows/Water/Meshes masters — deliberately NOT in
         ApplyDependencyState (its 4-call-site contract stays untouched). -->
    <Expander x:Name="VideoExpander" x:FieldModifier="internal"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE7F4;" FontSize="14" />
          <TextBlock Text="Video" FontWeight="SemiBold"
                     AutomationProperties.HeadingLevel="Level2" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="8">
        <!-- The retail launcher ships a THREE-WAY radio (None/Bloom/HDR), not two switches:
             HDR = bDoHighDynamicRange:BlurShaderHDR; Bloom = !HDR && bUseBlurShader:BlurShader;
             None = neither. Plain GroupName RadioButtons rather than the WinUI RadioButtons
             control: x:Name'd children inside its ItemsRepeater break the generated XAML
             connection table at runtime (InvalidCastException in Connect). -->
        <StackPanel x:Name="TonemapModePanel" x:FieldModifier="internal" Spacing="2">
          <TextBlock Text="Screen effects" />
          <RadioButton x:Name="TonemapNoneRadio" x:FieldModifier="internal" Content="None"
                       GroupName="ScreenEffects"
                       AutomationProperties.Name="Screen effects: none"
                       ToolTipService.ToolTip="No HDR and no bloom (the launcher's 'None'): plain SDR clamp" />
          <RadioButton x:Name="TonemapBloomRadio" x:FieldModifier="internal" Content="Bloom"
                       GroupName="ScreenEffects"
                       AutomationProperties.Name="Screen effects: bloom"
                       ToolTipService.ToolTip="SDR + bloom (bUseBlurShader): the retail LDR BlurShader path is unrecovered, so this is an SDR clamp plus the engine bright-pass bloom at neutral exposure — a documented stand-in" />
          <RadioButton x:Name="TonemapHdrRadio" x:FieldModifier="internal" Content="HDR"
                       GroupName="ScreenEffects" IsChecked="True"
                       AutomationProperties.Name="Screen effects: HDR"
                       ToolTipService.ToolTip="Engine HDR rendering (bDoHighDynamicRange): eye adaptation, weather-authored exposure and bloom" />
        </StackPanel>
        <ToggleSwitch x:Name="WaterReflectionsToggle" x:FieldModifier="internal" IsOn="True"
                      Header="Water reflections" OnContent="On" OffContent="Off"
                      AutomationProperties.Name="Water reflections"
                      ToolTipService.ToolTip="Mirror the scene (terrain, objects, sky) in water (bUseWaterReflections). Off = the engine's reflection-free water shading. Retail defaults reflect land + sky only; this includes objects and trees like the maxed ini set" />
        <ToggleSwitch x:Name="WaterRipplesToggle" x:FieldModifier="internal" IsOn="True"
                      Header="Water ripples" OnContent="On" OffContent="Off"
                      AutomationProperties.Name="Water ripples"
                      ToolTipService.ToolTip="Animated water surface ripple field (bUseWaterDisplacements). Off = a calm flat sheet; scrolling detail and reflections continue" />
        <ToggleSwitch x:Name="WindowReflectionsToggle" x:FieldModifier="internal" IsOn="True"
                      Header="Window reflections" OnContent="On" OffContent="Off"
                      AutomationProperties.Name="Window reflections"
                      ToolTipService.ToolTip="Environment-map reflections on window/glass materials (bDynamicWindowReflections)" />
        <ToggleSwitch x:Name="GrassShadowsToggle" x:FieldModifier="internal" IsOn="True"
                      Header="Shadows on grass" OnContent="On" OffContent="Off"
                      AutomationProperties.Name="Shadows on grass"
                      ToolTipService.ToolTip="Grass receives the sun shadow map (bShadowsOnGrass). Grass never casts shadows, matching the engine" />
        <ToggleSwitch x:Name="CanopyShadowsToggle" x:FieldModifier="internal" IsOn="True"
                      Header="Tree canopy shadows" OnContent="On" OffContent="Off"
                      AutomationProperties.Name="Tree canopy shadows"
                      ToolTipService.ToolTip="Trees cast shadows (bDoCanopyShadowPass). The viewer's real shadow map stands in for the engine's projected canopy textures" />
      </StackPanel>
    </Expander>

    <!-- ============================== Overlays ============================== -->
    <Expander x:Name="OverlaysExpander"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE81E;" FontSize="14" />
          <TextBlock Text="Overlays" FontWeight="SemiBold"
                     AutomationProperties.HeadingLevel="Level2" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="8">
        <CheckBox x:Name="CellsCheckBox" x:FieldModifier="internal" IsChecked="False" Content="Cell grid"
                  AutomationProperties.Name="Cell grid"
                  ToolTipService.ToolTip="Show the cell grid overlay (press 1)" />
        <CheckBox x:Name="NavMeshCheckBox" x:FieldModifier="internal" IsChecked="False" Content="Nav mesh"
                  AutomationProperties.Name="Nav mesh"
                  ToolTipService.ToolTip="Show the navmesh overlay (press 6)" />
        <CheckBox x:Name="CollisionCheckBox" x:FieldModifier="internal" IsChecked="False" Content="Collision mesh"
                  AutomationProperties.Name="Collision mesh"
                  ToolTipService.ToolTip="Overlay each object's walk-mode collision mesh as a green wireframe (compare against the rendered meshes)" />
        <CheckBox x:Name="FormIdHeatmapCheckBox" x:FieldModifier="internal" IsChecked="False" Content="FormID heatmap"
                  AutomationProperties.Name="FormID heatmap"
                  ToolTipService.ToolTip="Tint placed objects blue→red by FormID (FormIDs are sequential at authoring time, so cold = added early, hot = added late — cut-content archaeology)" />
        <!-- Range slider bounds/default must match FormIdHeatmapRangeScale (log₂ cells; the top
             ~0.32 band = Unlimited). SetFormIdHeatmap gates IsEnabled on the checkbox above. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="HeatmapRangeLabel" x:FieldModifier="internal" Text="Range" VerticalAlignment="Center" />
          <Slider x:Name="HeatmapRangeSlider" x:FieldModifier="internal" Width="130" VerticalAlignment="Center"
                  Minimum="1" Maximum="7.32" Value="7.32" StepFrequency="0.01" IsEnabled="False"
                  ThumbToolTipValueConverter="{StaticResource HeatmapRangeTooltip}"
                  AutomationProperties.Name="FormID heatmap range"
                  ToolTipService.ToolTip="Heatmap range: whole cells from the camera's cell (a full square block of cells, log scale); the top stop is unlimited" />
          <TextBlock x:Name="HeatmapRangeValueLabel" x:FieldModifier="internal" Text="∞" VerticalAlignment="Center" />
        </StackPanel>
        <!-- Heatmap key: the gradient bar is filled in code-behind by sampling FormIdHeatmapPalette
             (single source of truth — the key can never drift from the on-mesh ramp); the labels
             show the LIVE normalization window (lowest/highest FormID currently inside the selected
             cell block), pushed per change from the render loop via UpdateHeatmapKeyWindow.
             SetHeatmapKeyVisible collapses the whole block while the overlay is off. -->
        <StackPanel x:Name="HeatmapKeyPanel" x:FieldModifier="internal" Spacing="2" Visibility="Collapsed">
          <Rectangle x:Name="HeatmapKeyGradientBar" x:FieldModifier="internal" Height="10"
                     RadiusX="2" RadiusY="2" HorizontalAlignment="Stretch" />
          <Grid>
            <TextBlock x:Name="HeatmapKeyMinLabel" x:FieldModifier="internal" Text="oldest –"
                       FontSize="11" HorizontalAlignment="Left"
                       ToolTipService.ToolTip="Lowest FormID in range — authored earliest (blue end)" />
            <TextBlock x:Name="HeatmapKeyMaxLabel" x:FieldModifier="internal" Text="– newest"
                       FontSize="11" HorizontalAlignment="Right"
                       ToolTipService.ToolTip="Highest FormID in range — authored latest (red end)" />
          </Grid>
        </StackPanel>
      </StackPanel>
    </Expander>

    <!-- ============================== Visibility ============================== -->
    <Expander x:Name="VisibilityExpander"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE890;" FontSize="14" />
          <TextBlock Text="Visibility" FontWeight="SemiBold"
                     AutomationProperties.HeadingLevel="Level2" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="8">
        <TextBlock Text="Terrain" FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level3" />
        <CheckBox x:Name="TerrainToggle" x:FieldModifier="internal" IsChecked="True" Content="Terrain"
                  AutomationProperties.Name="Terrain"
                  ToolTipService.ToolTip="Show terrain (press 2)" />
        <StackPanel x:Name="TerrainDependentControls" Spacing="8">
          <CheckBox x:Name="TerrainTexturesToggle" x:FieldModifier="internal" IsChecked="True"
                    Content="Terrain textures"
                    AutomationProperties.Name="Terrain textures"
                    ToolTipService.ToolTip="Show terrain diffuse textures (off = flat shaded)" />
          <CheckBox x:Name="VertexColorsToggle" x:FieldModifier="internal" IsChecked="True" Content="Vertex colors"
                    AutomationProperties.Name="Vertex colors"
                    ToolTipService.ToolTip="Apply per-vertex terrain color tint (press 4)" />
        </StackPanel>
        <!--  Memory dumps only (visibility gated from LoadData). Data-source switch, not a render
              flag: it rebuilds the world data, so it deliberately sits OUTSIDE
              TerrainDependentControls — it also changes the 2D map, terrain display on or off.  -->
        <CheckBox x:Name="MasterTerrainCheckBox" x:FieldModifier="internal" IsChecked="True"
                  Content="Master ESM terrain" Visibility="Collapsed"
                  AutomationProperties.Name="Master ESM terrain"
                  ToolTipService.ToolTip="Fill terrain the dump lost from the Load Order's master ESMs (preview placements the way the converted plugin shows them in-game); off = only the terrain the dump itself preserved" />
        <CheckBox x:Name="WaterCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Water"
                  AutomationProperties.Name="Water"
                  ToolTipService.ToolTip="Show water surfaces (press 3)" />

        <Border Height="1" Margin="0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <CheckBox x:Name="RefsToggle" x:FieldModifier="internal" IsChecked="True" Content="Meshes"
                  AutomationProperties.Name="Placed objects"
                  ToolTipService.ToolTip="Show placed-object meshes (press 5)" />

        <StackPanel x:Name="MeshDependentControls" Spacing="8">
          <TextBlock Text="Plants" FontWeight="SemiBold"
                     AutomationProperties.HeadingLevel="Level3" />
          <CheckBox x:Name="GrassCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Grass"
                    AutomationProperties.Name="Grass"
                    ToolTipService.ToolTip="Show engine-scattered LAND/GRAS vegetation" />
          <CheckBox x:Name="TreesCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Trees"
                    AutomationProperties.Name="Trees"
                    ToolTipService.ToolTip="Show trees (SpeedTree .spt and NIF trees; hiding before load also skips decoding them)" />

          <TextBlock Text="Effects" FontWeight="SemiBold"
                     AutomationProperties.HeadingLevel="Level3" />
          <CheckBox x:Name="EffectsCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Effect meshes"
                    AutomationProperties.Name="Effect meshes"
                    ToolTipService.ToolTip="Show placed effect meshes (Effects\ folder: mist, dust, glows, ambient FX)" />
          <CheckBox x:Name="SkyMeshesCheckBox" x:FieldModifier="internal" IsChecked="False" Content="Sky meshes"
                    AutomationProperties.Name="Sky meshes"
                    ToolTipService.ToolTip="Show placed sky/glow meshes (Sky\ folder, e.g. DiamondCityGlow)" />
          <CheckBox x:Name="AnimationsCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Animations"
                    AutomationProperties.Name="Animations"
                    ToolTipService.ToolTip="Play NIF animations (banner sway, waterfall and lava scrolling); off = static rest pose" />

          <TextBlock Text="Others" FontWeight="SemiBold"
                     AutomationProperties.HeadingLevel="Level3" />
          <CheckBox x:Name="EditorMarkersCheckBox" x:FieldModifier="internal" IsChecked="False"
                    Content="Editor markers"
                    AutomationProperties.Name="Editor markers"
                    ToolTipService.ToolTip="Show editor/engine markers (XMarkers, travel/door markers)" />
          <CheckBox x:Name="ActivatorsCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Activators"
                    AutomationProperties.Name="Activators"
                    ToolTipService.ToolTip="Show activator objects (levers, terminals, buttons)" />
          <CheckBox x:Name="DisabledCheckBox" x:FieldModifier="internal" IsChecked="False"
                    Content="Initially-disabled objects"
                    AutomationProperties.Name="Initially-disabled objects"
                    ToolTipService.ToolTip="Show objects flagged initially-disabled (press 7)" />
        </StackPanel>

        <Button x:Name="ResetReferenceOverridesButton" x:FieldModifier="internal"
                Content="Reset per-object previews" IsEnabled="False"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Reset all per-object visibility previews"
                ToolTipService.ToolTip="Restore authored REFR/XESP visibility for every per-object Shown or Hidden preview in this scene" />
      </StackPanel>
    </Expander>

    <!-- ============================== Camera ============================== -->
    <Expander x:Name="CameraExpander"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE809;" FontSize="14" />
          <TextBlock Text="Camera" FontWeight="SemiBold"
                     AutomationProperties.HeadingLevel="Level2" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="10">
        <TextBlock Text="Projection" FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level3" />
        <RadioButtons x:Name="ProjectionModeRadios" x:FieldModifier="internal"
                      AutomationProperties.Name="Projection mode"
                      ToolTipService.ToolTip="In projection modes, drag to pan and Shift+drag to rotate"
                      SelectedIndex="0">
          <x:String>Perspective (default)</x:String>
          <x:String>Orthographic (top-down)</x:String>
          <x:String>Isometric</x:String>
          <x:String>Trimetric</x:String>
        </RadioButtons>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="FovLabel" x:FieldModifier="internal" Text="Field of view" VerticalAlignment="Center" />
          <Slider x:Name="FovSlider" x:FieldModifier="internal" Width="130" VerticalAlignment="Center"
                  Minimum="30" Maximum="110" Value="60" StepFrequency="1"
                  AutomationProperties.Name="Field of view"
                  ToolTipService.ToolTip="Perspective field of view (degrees) — perspective mode only" />
        </StackPanel>

        <Border Height="1" Margin="0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <ToggleSwitch x:Name="FlyModeToggle" x:FieldModifier="internal" IsOn="True"
                      Header="Camera mode" OnContent="Fly" OffContent="Walk"
                      AutomationProperties.Name="Camera mode"
                      ToolTipService.ToolTip="Fly (free camera) or Walk (ground-locked) — press F" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="DrawDistanceLabel" x:FieldModifier="internal" Text="Draw distance"
                     VerticalAlignment="Center" />
          <Slider x:Name="DrawDistanceSlider" x:FieldModifier="internal" Width="130" VerticalAlignment="Center"
                  Minimum="2" Maximum="7.64" Value="4" StepFrequency="0.01"
                  ThumbToolTipValueConverter="{StaticResource DrawDistanceTooltip}"
                  AutomationProperties.Name="Draw distance"
                  ToolTipService.ToolTip="Streaming view distance in cells, log scale (Page Up / Page Down)" />
          <TextBlock x:Name="DrawDistanceValueLabel" x:FieldModifier="internal" Text="16 c" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Expander>

  </StackPanel>
</UserControl>
