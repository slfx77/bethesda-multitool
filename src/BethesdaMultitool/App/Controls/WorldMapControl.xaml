<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="BethesdaMultitool.WorldMapControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar — unified with the 3D viewer's icon + submenu style (2.2). Navigation dropdowns +
         map-data selectors stay on the bar; Fit/Export are icon buttons; the former bottom filter
         strip is consolidated into Layers / Visibility submenus (FilterCheckboxPanel, hidden in
         cell-browser mode). Every filter keeps its x:Name + handler so code-behind is unchanged. -->
    <Grid Grid.Row="0" Padding="0,0,0,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Left: worldspace / cell navigation -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox x:Name="WorldspaceComboBox" MinWidth="220"
                  SelectionChanged="WorldspaceComboBox_SelectionChanged"
                  AutomationProperties.Name="Worldspace"
                  PlaceholderText="Select Worldspace" />
        <Button x:Name="InteriorsButton" Content="Interiors"
                Click="InteriorsButton_Click"
                ToolTipService.ToolTip="Browse interior cells" />
        <Button x:Name="AllCellsButton" Content="All Cells"
                Click="AllCellsButton_Click"
                ToolTipService.ToolTip="Browse all cells" />
      </StackPanel>

      <TextBlock x:Name="ZoomLevelText" Grid.Column="1" HorizontalAlignment="Right"
                 VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

      <!-- Right: map controls (always visible) + filter submenus (hidden in cell-browser mode) -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Click="ZoomFit_Click" MinWidth="0" Padding="9,6"
                ToolTipService.ToolTip="Zoom to fit" AutomationProperties.Name="Zoom to fit">
          <FontIcon Glyph="&#xE740;" FontSize="14" />
        </Button>
        <Button x:Name="ExportButton" Click="ExportButton_Click" IsEnabled="False"
                MinWidth="0" Padding="9,6"
                ToolTipService.ToolTip="Export worldspace as PNG for comparison"
                AutomationProperties.Name="Export worldspace as PNG">
          <FontIcon Glyph="&#xE74E;" FontSize="14" />
        </Button>
        <ComboBox x:Name="LayerComboBox" MinWidth="150"
                  SelectionChanged="LayerComboBox_SelectionChanged"
                  AutomationProperties.Name="Map layer"
                  ToolTipService.ToolTip="Map data layer" />
        <ComboBox x:Name="ColorSchemeComboBox" MinWidth="100"
                  SelectionChanged="ColorSchemeComboBox_SelectionChanged"
                  AutomationProperties.Name="Heightmap color scheme"
                  ToolTipService.ToolTip="Heightmap color scheme" />

        <StackPanel x:Name="FilterCheckboxPanel" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center">

          <!-- Layers: cell grid / nav mesh (vertex coloring is a map data layer here, not a toggle) -->
          <DropDownButton AutomationProperties.Name="Layers menu" ToolTipService.ToolTip="Layers">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE81E;" FontSize="14" />
              <TextBlock Text="Layers" />
            </StackPanel>
            <DropDownButton.Flyout>
              <Flyout>
                <StackPanel Spacing="8" MinWidth="200">
                  <CheckBox x:Name="CellGridCheckBox" Content="Cell grid" IsChecked="True"
                            AutomationProperties.Name="Cell grid"
                            ToolTipService.ToolTip="Show the cell grid overlay"
                            Checked="CellGridCheckBox_Changed" Unchecked="CellGridCheckBox_Changed" />
                  <CheckBox x:Name="NavMeshCheckBox" Content="Nav mesh" IsChecked="False"
                            AutomationProperties.Name="Nav mesh"
                            ToolTipService.ToolTip="Show the navmesh overlay"
                            Checked="NavMeshCheckBox_Changed" Unchecked="NavMeshCheckBox_Changed" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>

          <!-- Visibility: water / map markers / disabled / rendered models / dangling-REFR picker -->
          <DropDownButton AutomationProperties.Name="Visibility menu" ToolTipService.ToolTip="Visibility">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE890;" FontSize="14" />
              <TextBlock Text="Visibility" />
            </StackPanel>
            <DropDownButton.Flyout>
              <Flyout>
                <StackPanel Spacing="8" MinWidth="260">
                  <CheckBox x:Name="WaterCheckBox" Content="Water" IsChecked="True"
                            AutomationProperties.Name="Water"
                            ToolTipService.ToolTip="Show water surfaces"
                            Checked="WaterCheckBox_Changed" Unchecked="WaterCheckBox_Changed" />
                  <CheckBox x:Name="MapMarkersCheckBox" Content="Map markers" IsChecked="True"
                            AutomationProperties.Name="Map markers"
                            ToolTipService.ToolTip="Show map markers"
                            Checked="MapMarkersCheckBox_Changed" Unchecked="MapMarkersCheckBox_Changed" />
                  <CheckBox x:Name="DisabledCheckBox" Content="Initially disabled" IsChecked="False"
                            AutomationProperties.Name="Initially disabled"
                            ToolTipService.ToolTip="Show objects flagged initially-disabled"
                            Checked="DisabledCheckBox_Changed" Unchecked="DisabledCheckBox_Changed" />
                  <CheckBox x:Name="RenderedObjectsCheckBox" Content="Rendered models" IsChecked="False"
                            IsEnabled="False"
                            AutomationProperties.Name="Render placed objects top-down via the 3D renderer"
                            ToolTipService.ToolTip="Replace placed-object dots/boxes with a top-down rendered view of the actual models, occluded by terrain (exterior cells only; needs Meshes + Textures BSAs)"
                            Checked="RenderedObjectsCheckBox_Changed" Unchecked="RenderedObjectsCheckBox_Changed" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <TextBlock x:Name="DanglingRefsLabel" Text="Dangling REFRs:" VerticalAlignment="Center"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="DanglingRefsComboBox" MinWidth="100"
                              AutomationProperties.Name="Dangling REFR confidence threshold"
                              SelectionChanged="DanglingRefsComboBox_SelectionChanged"
                              ToolTipService.ToolTip="Memory-dump (DMP) feature only — has no effect on ESM/ESP files. Shows heap-resident REFRs that the cell-traversal pipeline missed, at or above the chosen confidence level.">
                      <ComboBoxItem Content="None" />
                      <ComboBoxItem Content="High" />
                      <ComboBoxItem Content="Medium" />
                      <ComboBoxItem Content="Low" />
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>

        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Win2D Canvas -->
    <canvas:CanvasControl x:Name="MapCanvas" Grid.Row="1"
                          IsTabStop="True"
                          AutomationProperties.Name="World map"
                          Draw="MapCanvas_Draw"
                          PointerPressed="MapCanvas_PointerPressed"
                          PointerMoved="MapCanvas_PointerMoved"
                          PointerReleased="MapCanvas_PointerReleased"
                          PointerWheelChanged="MapCanvas_PointerWheelChanged"
                          KeyDown="MapCanvas_KeyDown"
                          KeyUp="MapCanvas_KeyUp"
                          LostFocus="MapCanvas_LostFocus" />

    <Border x:Name="LayerBuildOverlay" Grid.Row="1"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,12,0,0" Padding="10,6"
            CornerRadius="4"
            Background="#E6191920"
            IsHitTestVisible="False"
            Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ProgressRing x:Name="LayerBuildProgress" Width="16" Height="16"
                      IsActive="False" />
        <TextBlock x:Name="LayerBuildStatusText" FontSize="12"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
      </StackPanel>
    </Border>

    <!-- Legend overlay (floating above canvas, bottom-left) -->
    <Border x:Name="LegendOverlay" Grid.Row="1"
            VerticalAlignment="Bottom" HorizontalAlignment="Left"
            Background="#E6191920"
            CornerRadius="4" Padding="6,4" Margin="8,0,0,8">
      <StackPanel Spacing="0">
        <Button x:Name="LegendToggleButton" Click="LegendToggle_Click"
                HorizontalAlignment="Left"
                Background="Transparent" BorderThickness="0"
                Padding="4,2" MinHeight="0" MinWidth="0"
                AutomationProperties.Name="Toggle legend">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <FontIcon x:Name="LegendToggleIcon" Glyph="&#xE70D;" FontSize="10" />
            <TextBlock Text="Legend" FontSize="10" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel x:Name="LegendPanel" Spacing="3" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- Cell Browser (shown instead of canvas when "All Cells" or "Interiors" is selected) -->
    <Grid x:Name="CellBrowserPanel" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBox x:Name="CellSearchBox" Grid.Row="0" PlaceholderText="Search cells..."
               AutomationProperties.Name="Search cells"
               TextChanged="CellSearchBox_TextChanged" Margin="0,0,0,4" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
        <CheckBox x:Name="FilterHasObjects" Content="Has objects"
                  Checked="CellFilter_Changed" Unchecked="CellFilter_Changed" />
        <CheckBox x:Name="FilterNamedOnly" Content="Named only"
                  Checked="CellFilter_Changed" Unchecked="CellFilter_Changed" />
        <ComboBox x:Name="CellSortCombo" MinWidth="120" VerticalAlignment="Center"
                  SelectedIndex="0"
                  AutomationProperties.Name="Sort cells"
                  ToolTipService.ToolTip="Sort cells within each group"
                  SelectionChanged="CellSortCombo_SelectionChanged">
          <ComboBoxItem Content="Sort: Grid" />
          <ComboBoxItem Content="Sort: Object count" />
        </ComboBox>
      </StackPanel>
      <ListView x:Name="CellListView" Grid.Row="2"
                SelectionMode="Single"
                AutomationProperties.Name="Cells in worldspace"
                SelectionChanged="CellListView_SelectionChanged">
        <ListView.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Key}" FontSize="13" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListView.GroupStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="4,2" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" FontSize="11" FontFamily="Consolas"
                         Text="{Binding GridLabel}" />
              <TextBlock Grid.Column="1" FontSize="11"
                         Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" FontSize="11" FontFamily="Consolas"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Text="{Binding ObjectCount}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>

    <!-- Status bar -->
    <Grid Grid.Row="2" Padding="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="HoverInfoText" Grid.Column="0" FontSize="11"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="CoordsText" Grid.Column="1" FontSize="11" FontFamily="Consolas"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
  </Grid>
</UserControl>
