<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="BethesdaMultitool.WorldMapExportPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:BethesdaMultitool">

  <!-- 2D map export, shown in the host's right-panel "Export" tab (replaces the old modal
       MapExportDialog + toolbar button), structured to match WorldView3DExportPanel so switching
       viewers keeps the same tab layout: source options / Include / Output. Pure declarative XAML:
       WorldMapControl constructs this panel, reaches the internal fields, and subscribes every
       control's events in WireExportPanel() — no logic lives here. Include-checkbox defaults mirror
       the viewer's _show* initializers; the owner re-seeds them from the live map when a worldspace
       loads (independent thereafter). -->
  <StackPanel Spacing="8">

    <!-- ============================== Layer & resolution ============================== -->
    <Expander x:Name="LayerExpander" IsExpanded="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <TextBlock Text="Layer" FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level2" />
      </Expander.Header>
      <StackPanel Spacing="10">
        <ComboBox x:Name="LayerComboBox" x:FieldModifier="internal"
                  Header="Map data layer" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Export layer"
                  ToolTipService.ToolTip="Which map data layer the exported PNG renders" />

        <StackPanel Spacing="4">
          <TextBlock Text="Resolution" FontWeight="SemiBold"
                     AutomationProperties.HeadingLevel="Level2" />
          <!-- Scale is relative to the selected layer's NATIVE source resolution — 33 px/cell for the
               heightmap family, 132 (up to 528) for the texture layer — so the presets stay meaningful
               when the layer changes. -->
          <TextBlock x:Name="WorldSizeText" x:FieldModifier="internal" FontSize="11" TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="Scale025Button" x:FieldModifier="internal" Content="0.25x" Tag="0.25"
                    AutomationProperties.Name="Quarter scale"
                    ToolTipService.ToolTip="A quarter of the layer's native px/cell" />
            <Button x:Name="Scale05Button" x:FieldModifier="internal" Content="0.5x" Tag="0.5"
                    AutomationProperties.Name="Half scale"
                    ToolTipService.ToolTip="Half the layer's native px/cell" />
            <Button x:Name="Scale1Button" x:FieldModifier="internal" Content="1x" Tag="1"
                    AutomationProperties.Name="Native scale"
                    ToolTipService.ToolTip="The layer's native source px/cell" />
            <Button x:Name="Scale2Button" x:FieldModifier="internal" Content="2x" Tag="2"
                    AutomationProperties.Name="Double scale"
                    ToolTipService.ToolTip="Twice the layer's native px/cell" />
            <Button x:Name="Scale4Button" x:FieldModifier="internal" Content="4x" Tag="4"
                    AutomationProperties.Name="Quadruple scale"
                    ToolTipService.ToolTip="Four times the layer's native px/cell" />
          </StackPanel>
        </StackPanel>

        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Long edge:" VerticalAlignment="Center" />
          <NumberBox Grid.Column="1" x:Name="LongEdgeNumberBox" x:FieldModifier="internal"
                     Minimum="32" Maximum="131072" SmallChange="64" LargeChange="512"
                     SpinButtonPlacementMode="Inline"
                     AutomationProperties.Name="Long edge in pixels" />
          <TextBlock Grid.Column="2" Text="px" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Expander>

    <!-- ============================== Include ============================== -->
    <Expander x:Name="IncludeExpander"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <TextBlock Text="Include" FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level2" />
      </Expander.Header>
      <StackPanel Spacing="8">
        <CheckBox x:Name="MarkersCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Map markers"
                  AutomationProperties.Name="Map markers" />
        <CheckBox x:Name="NavMeshCheckBox" x:FieldModifier="internal" IsChecked="False" Content="Nav mesh"
                  AutomationProperties.Name="Nav mesh" />
        <CheckBox x:Name="WaterCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Water"
                  AutomationProperties.Name="Water" />
        <CheckBox x:Name="GridCheckBox" x:FieldModifier="internal" IsChecked="True" Content="Cell grid"
                  AutomationProperties.Name="Cell grid" />
        <CheckBox x:Name="RenderedMeshesCheckBox" x:FieldModifier="internal" IsChecked="False"
                  Content="Rendered meshes (3D)"
                  AutomationProperties.Name="Rendered meshes"
                  ToolTipService.ToolTip="Composite a top-down 3D render of the placed objects over the terrain (needs the 3D viewer ready; exterior worldspaces only)" />
      </StackPanel>
    </Expander>

    <!-- ============================== Output ============================== -->
    <Expander x:Name="OutputExpander" IsExpanded="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <TextBlock Text="Output" FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level2" />
      </Expander.Header>
      <StackPanel Spacing="10">
        <CheckBox x:Name="TiledCheckBox" x:FieldModifier="internal" IsChecked="False"
                  Content="Tiled high-res (multiple PNGs + manifest)"
                  AutomationProperties.Name="Tiled high-res" />
        <TextBlock x:Name="OutputSizeText" x:FieldModifier="internal" FontSize="11" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel Spacing="4">
          <TextBlock Text="Folder" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="FolderTextBox" x:FieldModifier="internal" Width="240"
                     IsSpellCheckEnabled="False"
                     AutomationProperties.Name="Output folder"
                     ToolTipService.ToolTip="Destination folder for the exported PNG(s)" />
            <Button x:Name="BrowseFolderButton" x:FieldModifier="internal" Content="Browse…"
                    AutomationProperties.Name="Browse for output folder" />
          </StackPanel>
        </StackPanel>

        <TextBox x:Name="FileNameTextBox" x:FieldModifier="internal" Header="File name"
                 IsSpellCheckEnabled="False"
                 AutomationProperties.Name="Output file name"
                 ToolTipService.ToolTip="Base name for the PNG (tiled runs append _r{row}_c{col} + a manifest)" />

        <Button x:Name="ExportRunButton" x:FieldModifier="internal" Content="Export…"
                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"
                AutomationProperties.Name="Export"
                ToolTipService.ToolTip="Render and save the export to the chosen folder" />
      </StackPanel>
    </Expander>

  </StackPanel>
</UserControl>
