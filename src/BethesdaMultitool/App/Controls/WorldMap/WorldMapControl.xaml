<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="BethesdaMultitool.WorldMapControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:BethesdaMultitool"
  xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar — navigation dropdowns + map-data selectors + Fit/Export icon buttons. The former
         Lighting / Layers / Visibility / Shading dropdowns live in WorldMapSettingsPanel (the
         host's right-panel Settings tab), constructed + wired by this control (SettingsPanel /
         WireSettingsPanel). -->
    <Grid Grid.Row="0" Padding="0,0,0,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Left: worldspace / cell navigation -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox x:Name="WorldspaceComboBox" MinWidth="220"
                  SelectionChanged="WorldspaceComboBox_SelectionChanged"
                  AutomationProperties.Name="Worldspace"
                  PlaceholderText="Select Worldspace" />
        <Button x:Name="InteriorsButton" Content="Interiors"
                Click="InteriorsButton_Click"
                ToolTipService.ToolTip="Browse interior cells" />
        <Button x:Name="AllCellsButton" Content="All Cells"
                Click="AllCellsButton_Click"
                ToolTipService.ToolTip="Browse all cells" />
      </StackPanel>

      <TextBlock x:Name="ZoomLevelText" Grid.Column="1" HorizontalAlignment="Right"
                 VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

      <!-- Right: map controls (always visible) + filter submenus (hidden in cell-browser mode) -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Click="ZoomFit_Click" MinWidth="0" Padding="9,6"
                ToolTipService.ToolTip="Zoom to fit" AutomationProperties.Name="Zoom to fit">
          <FontIcon Glyph="&#xE740;" FontSize="14" />
        </Button>
        <Button x:Name="ExportButton" Click="ExportButton_Click" IsEnabled="False"
                MinWidth="0" Padding="9,6"
                ToolTipService.ToolTip="Export worldspace as PNG for comparison"
                AutomationProperties.Name="Export worldspace as PNG">
          <FontIcon Glyph="&#xE74E;" FontSize="14" />
        </Button>
        <ComboBox x:Name="LayerComboBox" MinWidth="150"
                  SelectionChanged="LayerComboBox_SelectionChanged"
                  AutomationProperties.Name="Map layer"
                  ToolTipService.ToolTip="Map data layer" />
        <ComboBox x:Name="ColorSchemeComboBox" MinWidth="100"
                  SelectionChanged="ColorSchemeComboBox_SelectionChanged"
                  AutomationProperties.Name="Heightmap color scheme"
                  ToolTipService.ToolTip="Heightmap color scheme" />
      </StackPanel>
    </Grid>

    <!-- Win2D Canvas -->
    <canvas:CanvasControl x:Name="MapCanvas" Grid.Row="1"
                          IsTabStop="True"
                          AutomationProperties.Name="World map"
                          Draw="MapCanvas_Draw"
                          PointerPressed="MapCanvas_PointerPressed"
                          PointerMoved="MapCanvas_PointerMoved"
                          PointerReleased="MapCanvas_PointerReleased"
                          PointerWheelChanged="MapCanvas_PointerWheelChanged"
                          KeyDown="MapCanvas_KeyDown"
                          KeyUp="MapCanvas_KeyUp"
                          LostFocus="MapCanvas_LostFocus" />

    <Border x:Name="LayerBuildOverlay" Grid.Row="1"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,12,0,0" Padding="10,6"
            CornerRadius="4"
            Background="#E6191920"
            IsHitTestVisible="False"
            Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ProgressRing x:Name="LayerBuildProgress" Width="16" Height="16"
                      IsActive="False" />
        <TextBlock x:Name="LayerBuildStatusText" FontSize="12"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
      </StackPanel>
    </Border>

    <!-- Legend overlay (floating above canvas, bottom-left) -->
    <Border x:Name="LegendOverlay" Grid.Row="1"
            VerticalAlignment="Bottom" HorizontalAlignment="Left"
            Background="#E6191920"
            CornerRadius="4" Padding="6,4" Margin="8,0,0,8">
      <StackPanel Spacing="0">
        <Button x:Name="LegendToggleButton" Click="LegendToggle_Click"
                HorizontalAlignment="Left"
                Background="Transparent" BorderThickness="0"
                Padding="4,2" MinHeight="0" MinWidth="0"
                AutomationProperties.Name="Toggle legend">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <FontIcon x:Name="LegendToggleIcon" Glyph="&#xE70D;" FontSize="10" />
            <TextBlock Text="Legend" FontSize="10" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel x:Name="LegendPanel" Spacing="3" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- Cell Browser (shown instead of canvas when "All Cells" or "Interiors" is selected) — the shared
         CellListControl (same list the 3D viewer uses). -->
    <Grid x:Name="CellBrowserPanel" Grid.Row="1" Visibility="Collapsed">
      <local:CellListControl x:Name="CellList" />
    </Grid>

    <!-- Status bar -->
    <Grid Grid.Row="2" Padding="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="HoverInfoText" Grid.Column="0" FontSize="11"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="CoordsText" Grid.Column="1" FontSize="11" FontFamily="Consolas"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
  </Grid>
</UserControl>
