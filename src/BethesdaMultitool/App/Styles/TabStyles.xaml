<?xml version="1.0" encoding="utf-8"?>

<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

  <!--
    Shared styles for tab layouts across the application.
    Import via: <ResourceDictionary Source="ms-appx:///App/Styles/TabStyles.xaml"/>
    -->

  <!-- Standard card container style -->
  <Style x:Key="CardBorderStyle"
         TargetType="Border" BasedOn="{StaticResource MultitoolCardBorderStyle}">
    <Setter Property="Padding"
            Value="8" />
  </Style>

  <!-- Dark card style (for hex viewer, etc.) -->
  <Style x:Key="DarkCardBorderStyle"
         TargetType="Border" BasedOn="{StaticResource MultitoolCardBorderStyle}">
    <Setter Property="Padding"
            Value="8" />
    <Setter Property="Background"
            Value="{ThemeResource CardBackgroundSolidBrush}" />
  </Style>

  <!-- Column header container style -->
  <Style x:Key="ColumnHeaderGridStyle"
         TargetType="Grid">
    <Setter Property="Margin"
            Value="0,0,0,4" />
    <Setter Property="Padding"
            Value="8,4" />
    <Setter Property="Background"
            Value="{ThemeResource SystemControlBackgroundListLowBrush}" />
    <Setter Property="CornerRadius"
            Value="4" />
  </Style>

  <!-- Sortable column header button style -->
  <Style x:Key="SortableColumnHeaderButtonStyle"
         TargetType="Button">
    <Setter Property="Padding"
            Value="0" />
    <Setter Property="HorizontalAlignment"
            Value="Left" />
    <Setter Property="Background"
            Value="Transparent" />
    <Setter Property="BorderThickness"
            Value="0" />
  </Style>

  <!-- Sort icon style -->
  <Style x:Key="SortIconStyle"
         TargetType="FontIcon">
    <Setter Property="FontSize"
            Value="10" />
    <Setter Property="Glyph"
            Value="" />
    <Setter Property="Visibility"
            Value="Collapsed" />
  </Style>

  <!-- Standard progress bar style (collapsed by default, positioned below file info card) -->
  <Style x:Key="TabProgressBarStyle"
         TargetType="ProgressBar">
    <Setter Property="Margin"
            Value="0,4,0,0" />
    <Setter Property="Visibility"
            Value="Collapsed" />
  </Style>

  <!-- Persistent workflow options -->
  <Style x:Key="ToolOptionsBorderStyle"
         TargetType="Border">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Width" Value="280" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />


    <Setter Property="Visibility" Value="Visible" />
  </Style>

  <!-- I/O section container style -->
  <Style x:Key="IoSectionGridStyle"
         TargetType="Grid">
    <Setter Property="Margin"
            Value="0,16,0,0" />
    <Setter Property="RowSpacing"
            Value="8" />
  </Style>

  <!-- I/O label style -->
  <Style x:Key="IoLabelStyle"
         TargetType="TextBlock">
    <Setter Property="Margin"
            Value="0,0,12,0" />
    <Setter Property="VerticalAlignment"
            Value="Center" />
  </Style>

  <!-- I/O text box style -->
  <Style x:Key="IoTextBoxStyle"
         TargetType="TextBox" BasedOn="{StaticResource MultitoolIoTextBoxStyle}" />

  <!-- Action bar container style -->
  <Style x:Key="ActionBarGridStyle"
         TargetType="Grid">
    <Setter Property="Margin"
            Value="0,8,0,0" />
    <Setter Property="ColumnSpacing"
            Value="16" />
  </Style>

  <!-- Tab header with title and subtitle -->
  <Style x:Key="TabHeaderStackPanelStyle"
         TargetType="StackPanel">
    <Setter Property="VerticalAlignment"
            Value="Bottom" />
  </Style>

  <!-- Tab subtitle style -->
  <Style x:Key="TabSubtitleStyle"
         TargetType="TextBlock">
    <Setter Property="Margin"
            Value="0,4,0,0" />
    <Setter Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- Select All/None button panel style -->
  <Style x:Key="SelectButtonsPanelStyle"
         TargetType="StackPanel">
    <Setter Property="VerticalAlignment"
            Value="Bottom" />
    <Setter Property="Orientation"
            Value="Horizontal" />
    <Setter Property="Spacing"
            Value="8" />
  </Style>

  <!-- ListView with virtualization for file lists -->
  <Style x:Key="FileListViewStyle"
         TargetType="ListView">
    <Setter Property="SelectionMode"
            Value="None" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <ItemsStackPanel CacheLength="2.0" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Standard list item row style -->
  <Style x:Key="ListItemRowGridStyle"
         TargetType="Grid">
    <Setter Property="Margin"
            Value="0,2" />
  </Style>

  <!-- Shared AWT-sized gap with the Toolkit's native grip and input handling. -->
  <Style x:Key="ResizableSplitterStyle"
         TargetType="toolkit:GridSplitter" BasedOn="{StaticResource MultitoolColumnSplitterStyle}" />

  <!--
    Collapsible side panels (PanelCollapseController). The collapse chevron sits in the panel
    header; the expand chevron fills the slim strip the collapsed panel leaves behind. Both are
    chrome-less so they read as an affordance on the panel, not as a command button — each USE
    SITE must still set AutomationProperties.Name, since a glyph carries no accessible name.
    -->
  <Style x:Key="PanelCollapseButtonStyle"
         TargetType="Button">
    <Setter Property="Padding"
            Value="5" />
    <Setter Property="MinWidth"
            Value="0" />
    <Setter Property="MinHeight"
            Value="0" />
    <Setter Property="VerticalAlignment"
            Value="Top" />
    <Setter Property="Background"
            Value="Transparent" />
    <Setter Property="BorderThickness"
            Value="0" />
  </Style>

  <Style x:Key="PanelExpandButtonStyle"
         TargetType="Button">
    <Setter Property="Padding"
            Value="4,10" />
    <Setter Property="MinWidth"
            Value="0" />
    <Setter Property="MinHeight"
            Value="0" />
    <Setter Property="HorizontalAlignment"
            Value="Stretch" />
    <Setter Property="VerticalAlignment"
            Value="Stretch" />
    <Setter Property="VerticalContentAlignment"
            Value="Top" />
    <Setter Property="Background"
            Value="Transparent" />
    <Setter Property="BorderThickness"
            Value="0" />
  </Style>

  <!--  Slim card the collapsed panel shrinks to; sized by PanelCollapseState.DefaultStripWidth.  -->
  <Style x:Key="CollapsedPanelStripStyle"
         TargetType="Border"
         BasedOn="{StaticResource CardBorderStyle}">
    <Setter Property="Padding"
            Value="2" />
    <Setter Property="VerticalAlignment"
            Value="Stretch" />
  </Style>

  <!--
    Consistent "no data loaded" placeholder text for each sub-tab in SingleFileTab.
    Centered in the tab's content area, secondary color, large enough to read.
    -->
  <Style x:Key="EmptyTabPlaceholderStyle"
         TargetType="TextBlock">
    <Setter Property="HorizontalAlignment"
            Value="Center" />
    <Setter Property="VerticalAlignment"
            Value="Center" />
    <Setter Property="TextAlignment"
            Value="Center" />
    <Setter Property="FontSize"
            Value="14" />
    <Setter Property="Foreground"
            Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

</ResourceDictionary>
