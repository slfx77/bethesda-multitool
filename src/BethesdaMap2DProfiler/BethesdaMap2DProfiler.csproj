<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>BethesdaMap2DProfiler</RootNamespace>
    <AssemblyName>BethesdaMap2DProfiler</AssemblyName>
    <Platforms>x64;AnyCPU</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ApplicationIcon>..\BethesdaMultitool\Assets\AppIcon.ico</ApplicationIcon>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <ShaderBytecodePackFileName>BethesdaMultitool.Shaders.dxbcpack</ShaderBytecodePackFileName>
    <!-- The optional top-down 3D path hosts WorldView3DControl in this project's TargetDir, so its
         referenced renderer pack must remain a physical sibling of this executable. -->
    <PropagateShaderBytecodePackFromProjectReference
        Condition="'$(PropagateShaderBytecodePackFromProjectReference)' == '' and
                   '$(BuildTestsOnly)' != 'true' and
                   '$(DesignTimeBuild)' != 'true' and
                   ('$(GenerateShaderBytecodePackOnBuild)' == '' or '$(GenerateShaderBytecodePackOnBuild)' == 'true') and
                   $([MSBuild]::IsOSPlatform('Windows'))">true</PropagateShaderBytecodePackFromProjectReference>
    <_ShaderBytecodePackPropagationEnabled
        Condition="'$(PropagateShaderBytecodePackFromProjectReference)' == 'true' and
                   '$(BuildTestsOnly)' != 'true' and
                   '$(DesignTimeBuild)' != 'true' and
                   '$(GenerateShaderBytecodePackOnBuild)' != 'false' and
                   $([MSBuild]::IsOSPlatform('Windows'))">true</_ShaderBytecodePackPropagationEnabled>
  </PropertyGroup>

  <!-- Fast test builds (-p:BuildTestsOnly=true) drop the BethesdaMultitool net10.0-windows TFM
       this GUI profiler depends on (WorldMapControl), so skip building it then. See the targets
       file for why this is gated at the import rather than via a target Condition. -->
  <PropertyGroup Condition="'$(BuildTestsOnly)' == 'true'">
    <CustomAfterMicrosoftCommonTargets>$(MSBuildThisFileDirectory)..\..\eng\SkipBuildInTestsOnly.targets</CustomAfterMicrosoftCommonTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BethesdaMultitool\BethesdaMultitool.csproj">
      <ShaderBytecodePackProducer>true</ShaderBytecodePackProducer>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\BethesdaMultitool\Assets\AppIcon.ico"
             Link="Assets\AppIcon.ico"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\BethesdaMultitool\Assets\AppIcon.png"
             Link="Assets\AppIcon.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Keep the referenced BethesdaMultitool PRI available: WorldMapControl's compiled
       XAML lives there. The profiler app has no App.xaml of its own, so it avoids the
       duplicate Files/App.xbf collision that the audio companion strips around. -->
  <Target Name="RemoveReferencedProjectPublishContent" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::new('%(FullPath)').Contains('BethesdaMultitool')) AND
                                        '%(Filename)%(Extension)' != '$(ShaderBytecodePackFileName)' AND
                                        !$([System.String]::new('%(FullPath)').Contains('bin')) AND
                                        !$([System.String]::new('%(FullPath)').Contains('.nuget'))" />
    </ItemGroup>
  </Target>

  <!-- Reuse BethesdaMultitool's explicit producer target rather than guessing its configuration /
       platform output path. The ordinary ProjectReference build has completed before this hook.
       Match ResolveProjectReferences property metadata so solution configuration/platform mappings
       are retained when the profiler and producer use different platforms. -->
  <Target Name="CopyShaderBytecodePackFromBethesdaMultitool"
          AfterTargets="Build"
          Condition="'$(_ShaderBytecodePackPropagationEnabled)' == 'true'">
    <ItemGroup>
      <_ShaderBytecodePackProducerProject Include="@(_MSBuildProjectReferenceExistent)"
          Condition="'%(_MSBuildProjectReferenceExistent.ShaderBytecodePackProducer)' == 'true'" />
    </ItemGroup>
    <Error Condition="'@(_ShaderBytecodePackProducerProject)' == ''"
           Text="No ProjectReference is marked as the shader-bytecode-pack producer." />
    <Error Condition="'@(_ShaderBytecodePackProducerProject->Count())' != '1'"
           Text="Exactly one ProjectReference must be marked as the shader-bytecode-pack producer." />
    <MSBuild Projects="@(_ShaderBytecodePackProducerProject)"
             Targets="GetShaderBytecodePackOutput"
             Properties="%(_ShaderBytecodePackProducerProject.SetConfiguration); %(_ShaderBytecodePackProducerProject.SetPlatform); %(_ShaderBytecodePackProducerProject.SetTargetFramework)"
             RemoveProperties="%(_ShaderBytecodePackProducerProject.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             BuildInParallel="false"
             RebaseOutputs="false">
      <Output TaskParameter="TargetOutputs" ItemName="_Map2DShaderBytecodePackSource" />
    </MSBuild>
    <Error Condition="'@(_Map2DShaderBytecodePackSource->Count())' != '1'"
           Text="BethesdaMultitool did not return exactly one generated shader bytecode pack." />
    <Copy SourceFiles="@(_Map2DShaderBytecodePackSource)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="_Map2DShaderBytecodePack" />
    </Copy>
    <ItemGroup>
      <FileWrites Include="@(_Map2DShaderBytecodePack)" />
    </ItemGroup>
  </Target>

  <!-- Single-file publication keeps the runtime-looked-up pack external to the bundle. -->
  <Target Name="IncludeShaderBytecodePackInMap2DProfilerPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="CopyShaderBytecodePackFromBethesdaMultitool"
          Condition="'$(_ShaderBytecodePackPropagationEnabled)' == 'true'">
    <Error Condition="'@(_Map2DShaderBytecodePack->Count())' != '1'"
           Text="The map profiler shader bytecode pack was not copied before publish item resolution." />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_Map2DShaderBytecodePack)">
        <RelativePath>%(_Map2DShaderBytecodePack.Filename)%(_Map2DShaderBytecodePack.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
