<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>BethesdaMap2DProfiler</RootNamespace>
    <AssemblyName>BethesdaMap2DProfiler</AssemblyName>
    <Platforms>x64;AnyCPU</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ApplicationIcon>..\BethesdaMultitool\Assets\AppIcon.ico</ApplicationIcon>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BethesdaMultitool\BethesdaMultitool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\BethesdaMultitool\Assets\AppIcon.ico"
             Link="Assets\AppIcon.ico"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\BethesdaMultitool\Assets\AppIcon.png"
             Link="Assets\AppIcon.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Keep the referenced BethesdaMultitool PRI available: WorldMapControl's compiled
       XAML lives there. The profiler app has no App.xaml of its own, so it avoids the
       duplicate Files/App.xbf collision that the audio companion strips around. -->
  <Target Name="RemoveReferencedProjectPublishContent" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::new('%(FullPath)').Contains('BethesdaMultitool')) AND
                                        !$([System.String]::new('%(FullPath)').Contains('bin')) AND
                                        !$([System.String]::new('%(FullPath)').Contains('.nuget'))" />
    </ItemGroup>
  </Target>

</Project>
