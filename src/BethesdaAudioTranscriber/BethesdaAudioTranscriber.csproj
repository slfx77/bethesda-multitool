<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>BethesdaAudioTranscriber</RootNamespace>
    <AssemblyName>BethesdaAudioTranscriber</AssemblyName>
    <Platforms>x64;AnyCPU</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!-- Fast test builds (-p:BuildTestsOnly=true) drop the BethesdaMultitool net10.0-windows TFM.
       This GUI companion app's XAML references the App's XAML metadata provider from that TFM, so
       it can't compile (and a stale full-build obj poisons incremental test builds) — skip it then.
       It is irrelevant to the test suite. See the targets file for why this is gated at the import. -->
  <PropertyGroup Condition="'$(BuildTestsOnly)' == 'true'">
    <CustomAfterMicrosoftCommonTargets>$(MSBuildThisFileDirectory)..\..\eng\SkipBuildInTestsOnly.targets</CustomAfterMicrosoftCommonTargets>
  </PropertyGroup>

  <!-- WinUI 3 packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <!-- Audio playback -->
  <ItemGroup>
    <PackageReference Include="NAudio" />
  </ItemGroup>

  <!-- Whisper speech-to-text -->
  <ItemGroup>
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
  </ItemGroup>

  <!-- Core library reference (BSA parsing, XMA conversion, ESM parsing) -->
  <ItemGroup>
    <ProjectReference Include="..\BethesdaMultitool\BethesdaMultitool.csproj" />
  </ItemGroup>

  <!-- Remove the referenced project's PRI from the PRI merge list to avoid duplicate Files/App.xbf.
       BethesdaMultitool.pri already contains an embedded App.xbf resource which collides with ours.
       We don't need its string resources, so excluding the entire PRI is safe. -->
  <Target Name="RemoveReferencedProjectPri" BeforeTargets="_GenerateProjectPriConfigurationFiles">
    <ItemGroup>
      <_PriFile Remove="@(_PriFile)" Condition="$([System.String]::new('%(Filename)').StartsWith('BethesdaMultitool'))" />
    </ItemGroup>
  </Target>

  <!-- Remove source/intermediate content owned by the referenced WinUI project, preserving its
       bin outputs. Resolve that project's directory explicitly: searching the entire path for
       "BethesdaMultitool" also matches local checkout names and hides unrelated duplicate items.
       DDXConv is used through its managed DLL; its RID and portable executable artifacts can
       both arrive through transitive references. Its apphost, dependency manifest and runtime
       configuration belong to standalone DDXConv, not this application's bundle. -->
  <Target Name="RemoveReferencedProjectPublishContent" BeforeTargets="_ComputeFilesToBundle">
    <PropertyGroup>
      <_ReferencedAppProjectDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\BethesdaMultitool'))</_ReferencedAppProjectDirectory>
      <_ReferencedAppBinDirectory>$([MSBuild]::NormalizeDirectory('$(_ReferencedAppProjectDirectory)bin'))</_ReferencedAppBinDirectory>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.RelativePath)' == 'DDXConv.exe' OR
                                        '%(ResolvedFileToPublish.RelativePath)' == 'DDXConv.deps.json' OR
                                        '%(ResolvedFileToPublish.RelativePath)' == 'DDXConv.runtimeconfig.json' OR
                                        ($([System.String]::new('%(ResolvedFileToPublish.FullPath)').StartsWith('$(_ReferencedAppProjectDirectory)', System.StringComparison.OrdinalIgnoreCase)) AND
                                         !$([System.String]::new('%(ResolvedFileToPublish.FullPath)').StartsWith('$(_ReferencedAppBinDirectory)', System.StringComparison.OrdinalIgnoreCase)))" />
    </ItemGroup>
  </Target>

  <!-- App icon (.ico for exe/taskbar, .png for in-app title bar) -->
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.png" />
  </ItemGroup>

</Project>
