<?xml version="1.0" encoding="utf-8"?>

<UserControl
  x:Class="FalloutXbox360Utils.WorldView3DControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar — mirrors WorldMapControl's worldspace picker. -->
    <Grid Grid.Row="0" Padding="0,0,0,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox x:Name="WorldspaceComboBox" MinWidth="220"
                  SelectionChanged="WorldspaceComboBox_SelectionChanged"
                  AutomationProperties.Name="Worldspace"
                  PlaceholderText="Select Worldspace" />
        <Button x:Name="InteriorsButton" Content="Interiors" IsEnabled="False"
                Click="InteriorsButton_Click"
                ToolTipService.ToolTip="Browse interior cells" />
        <!-- Atmosphere (P4): weather dropdown + time-of-day slider feed AtmosphereState. -->
        <ComboBox x:Name="WeatherComboBox" MinWidth="150"
                  SelectionChanged="WeatherComboBox_SelectionChanged"
                  AutomationProperties.Name="Weather"
                  ToolTipService.ToolTip="Weather — drives the sky / ambient / sun / fog colors"
                  PlaceholderText="Weather" />
        <TextBlock Text="Time" VerticalAlignment="Center" />
        <Slider x:Name="TimeSlider" Width="130" Minimum="0" Maximum="24" StepFrequency="0.1"
                Value="12" VerticalAlignment="Center"
                AutomationProperties.Name="Time of day"
                ToolTipService.ToolTip="Time of day (0–24h) — drives lighting + sky colors"
                ValueChanged="TimeSlider_ValueChanged" />
      </StackPanel>
      <!-- Layer toggles — icon ToggleButtons (key shortcut in parens). Each needs an
           AutomationProperties.Name for the accessibility ratchet (icon-only content). -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                  VerticalAlignment="Center">
        <ToggleButton x:Name="CellsCheckBox" IsChecked="False" MinWidth="0" Padding="9,6"
                      ToolTipService.ToolTip="Cell grid (1)" AutomationProperties.Name="Cell grid"
                      Checked="CellsCheckBox_Changed" Unchecked="CellsCheckBox_Changed">
          <FontIcon Glyph="&#xE80A;" FontSize="14" />
        </ToggleButton>
        <ToggleButton x:Name="TerrainToggle" IsChecked="True" MinWidth="0" Padding="9,6"
                      ToolTipService.ToolTip="Terrain (2)" AutomationProperties.Name="Terrain"
                      Checked="TerrainToggle_Changed" Unchecked="TerrainToggle_Changed">
          <FontIcon Glyph="&#xE909;" FontSize="14" />
        </ToggleButton>
        <ToggleButton x:Name="WaterCheckBox" IsChecked="True" MinWidth="0" Padding="9,6"
                      ToolTipService.ToolTip="Water (3)" AutomationProperties.Name="Water"
                      Checked="WaterCheckBox_Changed" Unchecked="WaterCheckBox_Changed">
          <FontIcon Glyph="&#xEB42;" FontSize="14" />
        </ToggleButton>
        <ToggleButton x:Name="VclrToggle" IsChecked="False" MinWidth="0" Padding="9,6"
                      ToolTipService.ToolTip="Vertex colors only (4)" AutomationProperties.Name="Vertex colors only"
                      Checked="VclrToggle_Changed" Unchecked="VclrToggle_Changed">
          <FontIcon Glyph="&#xE790;" FontSize="14" />
        </ToggleButton>
        <ToggleButton x:Name="RefsToggle" IsChecked="True" MinWidth="0" Padding="9,6"
                      ToolTipService.ToolTip="Placed objects (5)" AutomationProperties.Name="Placed objects"
                      Checked="RefsToggle_Changed" Unchecked="RefsToggle_Changed">
          <FontIcon Glyph="&#xE7B8;" FontSize="14" />
        </ToggleButton>
        <ToggleButton x:Name="NavMeshCheckBox" IsChecked="False" MinWidth="0" Padding="9,6"
                      ToolTipService.ToolTip="Nav mesh (6)" AutomationProperties.Name="Nav mesh"
                      Checked="NavMeshCheckBox_Changed" Unchecked="NavMeshCheckBox_Changed">
          <FontIcon Glyph="&#xE816;" FontSize="14" />
        </ToggleButton>
        <ToggleButton x:Name="DisabledCheckBox" IsChecked="False" MinWidth="0" Padding="9,6"
                      ToolTipService.ToolTip="Initially-disabled objects (7)" AutomationProperties.Name="Initially-disabled objects"
                      Checked="DisabledCheckBox_Changed" Unchecked="DisabledCheckBox_Changed">
          <FontIcon Glyph="&#xE7B3;" FontSize="14" />
        </ToggleButton>
        <ToggleButton x:Name="LightingToggle" IsChecked="True" MinWidth="0" Padding="9,6"
                      ToolTipService.ToolTip="Lighting (8)" AutomationProperties.Name="Lighting"
                      Checked="LightingToggle_Changed" Unchecked="LightingToggle_Changed">
          <FontIcon Glyph="&#xE706;" FontSize="14" />
        </ToggleButton>
        <ToggleButton x:Name="SkyboxToggle" IsChecked="True" MinWidth="0" Padding="9,6"
                      ToolTipService.ToolTip="Skybox (9)" AutomationProperties.Name="Skybox"
                      Checked="SkyboxToggle_Changed" Unchecked="SkyboxToggle_Changed">
          <FontIcon Glyph="&#xE753;" FontSize="14" />
        </ToggleButton>
      </StackPanel>
    </Grid>

    <!-- 3D viewport — SwapChainPanel + status overlay + HUD. -->
    <Grid Grid.Row="1">
      <SwapChainPanel x:Name="RenderPanel"
                      IsTabStop="True"
                      AutomationProperties.Name="3D worldspace view" />
      <TextBlock x:Name="StatusOverlay"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="14"
                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                 AutomationProperties.Name="3D view status"
                 Visibility="Collapsed" />
      <Border x:Name="HudPanel"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="8" Padding="8,4"
              CornerRadius="4"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              Opacity="0.85">
        <TextBlock x:Name="HudText"
                   FontFamily="Consolas" FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   AutomationProperties.Name="3D view HUD"
                   Text="" />
      </Border>

      <!-- Interior cell browser — reuses the 2D viewer's searchable/filterable grouped list
           (WorldMapCellBrowser). Overlays the viewport while browsing; picking a cell loads it
           into the 3D scene and hides the panel. -->
      <Grid x:Name="CellBrowserPanel" Visibility="Collapsed" Padding="8"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,4" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Interior cells" VerticalAlignment="Center"
                     FontWeight="SemiBold" />
          <Button Grid.Column="1" x:Name="CellBrowserCloseButton" Content="Close"
                  Click="CellBrowserCloseButton_Click"
                  AutomationProperties.Name="Close interior browser" />
        </Grid>
        <TextBox x:Name="CellSearchBox" Grid.Row="1" PlaceholderText="Search cells..."
                 AutomationProperties.Name="Search cells"
                 TextChanged="CellSearchBox_TextChanged" Margin="0,0,0,4" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
          <CheckBox x:Name="FilterHasObjects" Content="Has objects"
                    Checked="CellFilter_Changed" Unchecked="CellFilter_Changed" />
          <CheckBox x:Name="FilterNamedOnly" Content="Named only"
                    Checked="CellFilter_Changed" Unchecked="CellFilter_Changed" />
          <TextBlock x:Name="CellBrowserCountText" VerticalAlignment="Center" FontSize="11"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ListView x:Name="CellListView" Grid.Row="3"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  AutomationProperties.Name="Interior cells"
                  ItemClick="CellListView_ItemClick">
          <ListView.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Key}" FontSize="13" FontWeight="Bold"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListView.GroupStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="4,2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" FontFamily="Consolas"
                           Text="{Binding GridLabel}" />
                <TextBlock Grid.Column="1" FontSize="11"
                           Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" FontSize="11" FontFamily="Consolas"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{Binding ObjectCount}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
